---
import Base from '../layouts/Base.astro';
import '../styles/pipeline-paths.css';
---
<Base
  title="Pipeline Paths by Content Category"
  active="pipeline-paths"
  description="How the 18-phase podcast pipeline branches differently based on content genre — Islamic/Scholarly, Sites/Consumer, and Explainers/Technical."
>
  <div class="pp-page">

    <!-- ════════════════════════════════════════════════════════════════
         HERO (REQ-013: .page-hero + .page-hero-title gradient text)
         REQ-035: ≤200 words in first viewport, no unexplained jargon.
         ════════════════════════════════════════════════════════════════ -->
    <header class="page-hero">
      <div class="page-hero-inner">
        <span class="eyebrow">System reference</span>
        <h1 class="page-hero-title">Pipeline Paths by Content Category</h1>
        <p class="page-hero-lede">
          The Podcast Factory runs every piece of content through the same 18 phases —
          but what each phase <em>does</em> changes based on content genre.
          This page shows exactly where the Islamic/Scholarly path, the Sites/Consumer path,
          and the Explainers/Technical path diverge, what drives each fork (a different
          prompt, a different rule set, or a full skip), and which forks are already built.
        </p>
      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════════════
         SECTION 01 — BRANCH MAP TABLE
         REQ-004: id="s01-branch-map", h2 with num marker.
         REQ-052: .table-container[role="region"][tabindex="0"].
         ════════════════════════════════════════════════════════════════ -->
    <section id="s01-branch-map" class="pp-section">
      <h2><span class="num">01</span> Branch map — all 18 phases</h2>
      <p class="pp-section-intro">
        Each row is one pipeline phase. The <strong>Branch type</strong> column tells you
        <em>how</em> the phase varies: a different AI prompt (🟡 PROMPT), a different rule
        constant (🔵 RULES), a complete skip (🔴 SKIP), or no variation at all (🟢 SHARED).
        The <strong>Status</strong> column shows whether the branching logic is already built.
      </p>

      <!-- Legend (REQ-037: gloss each domain term at first use) -->
      <div class="pp-legend" role="note" aria-label="Branch type legend">
        <span class="pp-legend-item">
          <span class="bt-badge bt-shared">🟢 SHARED</span>
          One implementation, all categories
        </span>
        <span class="pp-legend-item">
          <span class="bt-badge bt-prompt">🟡 PROMPT</span>
          Same phase, different AI prompt per category
        </span>
        <span class="pp-legend-item">
          <span class="bt-badge bt-rules">🔵 RULES</span>
          Same phase, different rule constants or checker
        </span>
        <span class="pp-legend-item">
          <span class="bt-badge bt-skip">🔴 SKIP</span>
          Phase skipped entirely for this category
        </span>
        <span class="pp-legend-item">
          <span class="bt-badge bt-partial">⚠️ PARTIAL</span>
          Phase partially branched — some categories handled, others not
        </span>
      </div>

      <!-- REQ-052: role="region" + tabindex="0" on scrollable wrapper -->
      <div class="table-container" role="region" aria-label="Pipeline branch map" tabindex="0">
        <table class="pp-table">
          <thead>
            <tr>
              <th class="col-phase" scope="col">Phase</th>
              <th class="col-desc" scope="col">Description</th>
              <th class="col-category" scope="col">Islamic / Scholarly</th>
              <th class="col-category" scope="col">Sites / Consumer</th>
              <th class="col-category" scope="col">Explainers / Technical</th>
              <th class="col-branch" scope="col">Branch type</th>
              <th class="col-status" scope="col">Status</th>
            </tr>
          </thead>
          <tbody>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">01</span>
                <span class="col-phase-name">preflight</span>
              </td>
              <td class="col-desc">Git state + source format check</td>
              <td class="col-category">Expects Arabic PDF</td>
              <td class="col-category">Expects scraped markdown</td>
              <td class="col-category">Expects synthesized markdown</td>
              <td class="col-branch"><span class="bt-badge bt-partial">⚠️ PARTIAL</span></td>
              <td class="col-status"><span class="st-note">Needs source-format check</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">02</span>
                <span class="col-phase-name">branch</span>
              </td>
              <td class="col-desc">Bucket branch creation</td>
              <td class="col-category"><code>Islamic/</code> bucket</td>
              <td class="col-category"><code>Guides/</code> bucket</td>
              <td class="col-category"><code>Technical/</code> bucket</td>
              <td class="col-branch"><span class="bt-badge bt-shared">🟢 SHARED</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">03</span>
                <span class="col-phase-name">scaffold</span>
              </td>
              <td class="col-desc">Directory structure setup</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-branch"><span class="bt-badge bt-shared">🟢 SHARED</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">04</span>
                <span class="col-phase-name">ocr-translate / source-ingest</span>
              </td>
              <td class="col-desc">Azure OCR + Translator (PDF) or local .md ingest (pre-written)</td>
              <td class="col-category">Run — Arabic PDF → English via <code>ingest_source.py</code></td>
              <td class="col-category"><code>phase_0a_ingest_source_md</code> — reads <code>source/*.md</code> → <code>raw-extract.md</code></td>
              <td class="col-category"><code>phase_0a_ingest_source_md</code> — reads <code>source/*.md</code> → <code>raw-extract.md</code></td>
              <td class="col-branch"><span class="bt-badge bt-skip">🔴 SKIP (OCR)</span> / <span class="bt-badge bt-shared">🟢 source-ingest</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">05</span>
                <span class="col-phase-name">refine-english (0b)</span>
              </td>
              <td class="col-desc">Source text denoise / refinement</td>
              <td class="col-category">Preserve Arabic terms + scholarly tone</td>
              <td class="col-category">Strip legal/compliance jargon (web-consumer-denoise)</td>
              <td class="col-category">Strip marketing language, preserve CLI syntax + code blocks</td>
              <td class="col-branch"><span class="bt-badge bt-prompt">🟡 PROMPT</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">06</span>
                <span class="col-phase-name">glossary (0c)</span>
              </td>
              <td class="col-desc">Arabic glossary scaffold</td>
              <td class="col-category">Run — scaffolds <code>glossary.yml</code></td>
              <td class="col-category"><span class="bt-badge bt-skip">🔴 SKIP</span></td>
              <td class="col-category"><span class="bt-badge bt-skip">🔴 SKIP</span></td>
              <td class="col-branch"><span class="bt-badge bt-skip">🔴 SKIP</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">07</span>
                <span class="col-phase-name">chapter-design (0d)</span>
              </td>
              <td class="col-desc">Episode segmentation + contracts</td>
              <td class="col-category">Scholarly chapter structure, inline exonym resolution</td>
              <td class="col-category">Consumer topic structure</td>
              <td class="col-category">Technical episode arc, no phonetics</td>
              <td class="col-branch"><span class="bt-badge bt-prompt">🟡 PROMPT</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">08</span>
                <span class="col-phase-name">enrichment (0e)</span>
              </td>
              <td class="col-desc">Add citations + depth</td>
              <td class="col-category">7-tier Islamic hierarchy (Quran → hadith → modern scholarship)</td>
              <td class="col-category"><span class="bt-badge bt-skip">🔴 SKIP</span></td>
              <td class="col-category">Official docs accuracy verification</td>
              <td class="col-branch"><span class="bt-badge bt-mixed">🟡 PROMPT + 🔴 SKIP</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">09</span>
                <span class="col-phase-name">series-plan</span>
              </td>
              <td class="col-desc">Series-level audience + angle</td>
              <td class="col-category">Scholarly tradition, doctrinal framing</td>
              <td class="col-category">Consumer benefits, plain-English</td>
              <td class="col-category">Developer onboarding, practical workflow</td>
              <td class="col-branch"><span class="bt-badge bt-prompt">🟡 PROMPT</span></td>
              <td class="col-status"><span class="st-missing">❌ Not category-aware</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">10</span>
                <span class="col-phase-name">register-series</span>
              </td>
              <td class="col-desc">Catalog registration</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-branch"><span class="bt-badge bt-shared">🟢 SHARED</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">11a</span>
                <span class="col-phase-name">per-chapter: Noise routing</span>
              </td>
              <td class="col-desc">Paragraph noise filtering (rule + Sonnet)</td>
              <td class="col-category">Protects Arabic text + spiritual/doctrinal</td>
              <td class="col-category">Protects financial figures + product claims</td>
              <td class="col-category">Protects code blocks + CLI commands</td>
              <td class="col-branch"><span class="bt-badge bt-mixed">🟡 PROMPT + 🔵 RULES</span></td>
              <td class="col-status"><span class="st-missing">❌ Sonnet prompt hardcodes spiritual</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">11b</span>
                <span class="col-phase-name">per-chapter: Framing</span>
              </td>
              <td class="col-desc">NotebookLM customize prompt</td>
              <td class="col-category">Scholar/seeker hosts, Arabic pronunciation, 5-beat doctrinal structure</td>
              <td class="col-category">John/Hannah consumer hosts, financial walkthrough</td>
              <td class="col-category">Developer-to-developer hosts, CLI workflow, official-docs accuracy</td>
              <td class="col-branch"><span class="bt-badge bt-prompt">🟡 PROMPT</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">11c</span>
                <span class="col-phase-name">per-chapter: Build + gates</span>
              </td>
              <td class="col-desc"><code>build_episode_txt.py</code> validation</td>
              <td class="col-category">R-NO-ABBREVIATION, R-HONORIFIC-ONCE, R-PHONETICS-OUT</td>
              <td class="col-category">Financial accuracy gates</td>
              <td class="col-category">Technical accuracy gates (no undefined acronyms)</td>
              <td class="col-branch"><span class="bt-badge bt-rules">🔵 RULES</span></td>
              <td class="col-status"><span class="st-missing">❌ Islamic gates fire on all categories</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">11d</span>
                <span class="col-phase-name">per-chapter: Challenger</span>
              </td>
              <td class="col-desc">Semantic quality validation</td>
              <td class="col-category">Full Islamic rule set (R-NO-ARABIC-NAMES, R-HOST-ROLE-PARITY)</td>
              <td class="col-category">Consumer challenger rules</td>
              <td class="col-category">Technical challenger rules (TECHNICAL_RULE_SET declared in <code>_rules.py</code>)</td>
              <td class="col-branch"><span class="bt-badge bt-rules">🔵 RULES</span></td>
              <td class="col-status"><span class="st-partial">⚠️ Rules declared; not yet wired to scorer</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">11b</span>
                <span class="col-phase-name">slide-decks</span>
              </td>
              <td class="col-desc">Optional slide deck generation</td>
              <td class="col-category">Islamic visual design</td>
              <td class="col-category">Consumer: uses Islamic prompt (adequate for now)</td>
              <td class="col-category">Technical: <code>_build_pair_prompt_technical</code> — CLI workflows, comparison tables, architecture flows</td>
              <td class="col-branch"><span class="bt-badge bt-prompt">🟡 PROMPT</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">12</span>
                <span class="col-phase-name">trainer</span>
              </td>
              <td class="col-desc">Cross-book pattern learning</td>
              <td class="col-category">Islamic challenger reports</td>
              <td class="col-category">Consumer reports</td>
              <td class="col-category">Technical reports</td>
              <td class="col-branch"><span class="bt-badge bt-partial">⚠️ PARTIAL</span></td>
              <td class="col-status"><span class="st-missing">❌ Assumes Islamic finding types</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">13</span>
                <span class="col-phase-name">merge</span>
              </td>
              <td class="col-desc">Merge branch → develop</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-branch"><span class="bt-badge bt-shared">🟢 SHARED</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

            <tr>
              <td class="col-phase">
                <span class="col-phase-num">14</span>
                <span class="col-phase-name">done</span>
              </td>
              <td class="col-desc">Finalize</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-category">Same</td>
              <td class="col-branch"><span class="bt-badge bt-shared">🟢 SHARED</span></td>
              <td class="col-status"><span class="st-done">✅ Done</span></td>
            </tr>

          </tbody>
        </table>
      </div>
    </section>

    <hr />

    <!-- ════════════════════════════════════════════════════════════════
         SECTION 02 — SVG SWIMLANE DIAGRAM
         REQ-004: id="s02-swimlane", h2 with num marker.
         REQ-021: inline SVG only.
         REQ-022: role="img" + aria-labelledby + <title> + <desc>.
         REQ-023: <figure class="diagram-container"> + <figcaption>.
         REQ-024: viewBox only, no width/height attrs.
         D-DIAGRAM: vertical top→bottom, no height clamp.
         ════════════════════════════════════════════════════════════════ -->
    <section id="s02-swimlane" class="pp-section">
      <h2><span class="num">02</span> Visual swimlane — three paths in parallel</h2>
      <p class="pp-section-intro">
        The diagram below shows all 18 phases as horizontal rows, with the three content paths
        as vertical lanes. A block spanning all three lanes means the phase is <strong>SHARED</strong>.
        Separate coloured blocks mean the phase branches — each lane shows what that path does.
      </p>

      <figure class="diagram-container">
        <svg
          viewBox="0 0 900 2460"
          role="img"
          aria-labelledby="swimlane-title swimlane-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="swimlane-title">Pipeline branch swimlane — 18 phases across 3 content paths</title>
          <desc id="swimlane-desc">
            A vertical swimlane showing 18 pipeline phases (rows) across three content-category
            lanes (Islamic/Scholarly, Sites/Consumer, Explainers/Technical). Shared phases span
            all three lanes in green. Branching phases show coloured blocks per lane: amber for
            prompt-branching, blue for rules-branching, red for skipped, orange for partial.
          </desc>

          <!-- ── Colour definitions matching theme tokens ─────────────────────── -->
          <!-- SHARED:  --c-green   = #4a7c4a -->
          <!-- PROMPT:  --c-amber   = #c08020 -->
          <!-- RULES:   --c-planner = #1a5c8a -->
          <!-- SKIP:    --c-red     = #a83232 -->
          <!-- PARTIAL: --c-gold    = #b8860b -->

          <!-- ── Layout constants ────────────────────────────────────────────────
               Total width: 900
               Left margin (labels): 140
               Lane area: 760 (900 - 140)
               3 lanes at ~253px each (with 2px gaps)
               Phase row height: 120px
               Header height: 60px
               Total height: 60 + 18*120 + padding = 2460
          ──────────────────────────────────────────────────────────────────────── -->

          <!-- ── Background ─────────────────────────────────────────────────────── -->
          <rect x="0" y="0" width="900" height="2460" fill="#f7f4ee" rx="6"/>

          <!-- ── Column headers ─────────────────────────────────────────────────── -->
          <!-- Phase label column -->
          <rect x="0" y="0" width="140" height="60" fill="#efeae0"/>
          <text x="70" y="36" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="11" font-weight="700" fill="#4d4a42" text-transform="uppercase" letter-spacing="0.06em">PHASE</text>

          <!-- Islamic/Scholarly lane header -->
          <rect x="142" y="0" width="250" height="60" fill="#efeae0"/>
          <text x="267" y="22" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="12" font-weight="700" fill="#4a7c4a">Islamic / Scholarly</text>
          <text x="267" y="40" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="10" fill="#87827a">books · letters · lectures · articles</text>

          <!-- Sites/Consumer lane header -->
          <rect x="394" y="0" width="250" height="60" fill="#efeae0"/>
          <text x="519" y="22" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="12" font-weight="700" fill="#c08020">Sites / Consumer</text>
          <text x="519" y="40" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="10" fill="#87827a">healthequity · product docs</text>

          <!-- Explainers/Technical lane header -->
          <rect x="646" y="0" width="254" height="60" fill="#efeae0"/>
          <text x="773" y="22" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="12" font-weight="700" fill="#1a5c8a">Explainers / Technical</text>
          <text x="773" y="40" text-anchor="middle" font-family="Lato, system-ui, sans-serif" font-size="10" fill="#87827a">developer docs · training</text>

          <!-- ── Vertical lane dividers ───────────────────────────────────────── -->
          <line x1="140" y1="0" x2="140" y2="2460" stroke="#d9d3c4" stroke-width="2"/>
          <line x1="392" y1="0" x2="392" y2="2460" stroke="#d9d3c4" stroke-width="1"/>
          <line x1="644" y1="0" x2="644" y2="2460" stroke="#d9d3c4" stroke-width="1"/>

          <!-- ══════════════════════════════════════════════════════════════════
               PHASE ROWS — each at y = 60 + (rowIndex * 120)
               Row 0  → y=60   (01 preflight)
               Row 1  → y=180  (02 branch)
               Row 2  → y=300  (03 scaffold)
               Row 3  → y=420  (04 ocr-translate)
               Row 4  → y=540  (05 refine-english)
               Row 5  → y=660  (06 phonetics)
               Row 6  → y=780  (07 chapter-design)
               Row 7  → y=900  (08 enrichment)
               Row 8  → y=1020 (09 series-plan)
               Row 9  → y=1140 (10 register-series)
               Row 10 → y=1260 (11a noise-routing)
               Row 11 → y=1380 (11b framing)
               Row 12 → y=1500 (11c build-gates)
               Row 13 → y=1620 (11d challenger)
               Row 14 → y=1740 (11b slide-decks)
               Row 15 → y=1860 (12 trainer)
               Row 16 → y=1980 (13 merge)
               Row 17 → y=2100 (14 done)
               + legend at y=2220
          ══════════════════════════════════════════════════════════════════ -->

          <!-- Row separators -->
          <line x1="0" y1="60"   x2="900" y2="60"   stroke="#d9d3c4" stroke-width="2"/>
          <line x1="0" y1="180"  x2="900" y2="180"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="300"  x2="900" y2="300"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="420"  x2="900" y2="420"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="540"  x2="900" y2="540"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="660"  x2="900" y2="660"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="780"  x2="900" y2="780"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="900"  x2="900" y2="900"  stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1020" x2="900" y2="1020" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1140" x2="900" y2="1140" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1260" x2="900" y2="1260" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1380" x2="900" y2="1380" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1500" x2="900" y2="1500" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1620" x2="900" y2="1620" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1740" x2="900" y2="1740" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1860" x2="900" y2="1860" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="1980" x2="900" y2="1980" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="2100" x2="900" y2="2100" stroke="#ebe6da" stroke-width="1"/>
          <line x1="0" y1="2220" x2="900" y2="2220" stroke="#d9d3c4" stroke-width="2"/>

          <!-- ── Phase label column (left) ─────────────────────────────────────── -->

          <!-- 01 preflight -->
          <text x="8" y="88"  font-family="Lato, system-ui, sans-serif" font-size="10" font-weight="700" fill="#8b4513">01</text>
          <text x="8" y="104" font-family="Lato, system-ui, sans-serif" font-size="11" font-weight="700" fill="#1f1d18">preflight</text>
          <text x="8" y="118" font-family="Lato, system-ui, sans-serif" font-size="9"  fill="#87827a">⚠️ PARTIAL</text>

