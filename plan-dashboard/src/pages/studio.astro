---
/**
 * Studio landing — the book picker for the content pipeline.
 *
 * Books are grouped by content bucket (Islamic / Fiction / Technical / Guides),
 * each rendered as a visual bookshelf section. Each card deep-links to that
 * book's current pipeline step. All derived view state lives in
 * lib/reader/studio-shelves.ts (R2 extraction); destructured under the
 * template's long-standing names — template unchanged.
 */
import Base from "../layouts/Base.astro";
import BookCard from "../components/studio/BookCard.astro";
import { buildStudioShelves } from "../lib/reader/studio-shelves";
import "../styles/studio-pipeline.css";

const {
  shelves,
  STATUS_FILTERS,
  TRACK_FILTERS,
  statusCount,
  trackCount,
  bucketCount,
  totalCount,
} = await buildStudioShelves();
---

<Base
  title="Studio"
  active="studio"
  description="Pick a book to work on through the content pipeline."
>
  <div class="studio-picker">
    {
      /* The instruction paragraphs that stood here were removed 2026-08-15 —
         the page explains itself and they cost a screen of height before the
         first book. The two links they carried (Pre-Upload Review,
         Pronunciation) were the ONLY route to those pages anywhere on the
         site, so they moved into the Studio section subnav rather than being
         deleted with the prose. See SUBNAV.studio in lib/site-nav.ts. */
    }
    {
      /* The eyebrow and headline went with the prose (Asif, 2026-08-15): the
         top nav and the section row above already say Studio · Books, so the
         block was restating the page's own chrome and pushing the filters and
         the first shelf down a screen.

         The heading itself is KEPT, visually hidden. Deleting the element
         would leave the page with no h1 at all and jump the outline straight
         to the shelves' h2s — a real defect for anyone navigating by heading,
         and invisible on screen either way. */
    }
    <h1 class="sr-only">Studio — work a book through the pipeline</h1>

    {
      /* THREE facets, each single-select with its own "All", narrowing
         together. Category and status share the first row — both ask where a
         book is in the PIPELINE. The track row sits below with its own label,
         because "what is this book about" is a different question and,
         practically, fifteen chips do not fit one line at any width this site
         is used at.

         `aria-pressed` on buttons rather than radios: the Podcast Factory
         Library's find row is built this way, and "pressed" is the honest
         shape for a chosen chip. Exactly one chip per group carries
         `aria-pressed="true"` at any moment; the script enforces it. */
    }

    {
      /* THE FIND BAR — one bordered panel, header row above a hairline, chips
         below it. The site already had this panel treatment (`.studio-panel`,
         used on every step page); the top of the picker was the one place not
         using it, which is why it read as loose parts on the page rather than a
         header. Structure follows the classic admin card: title and live count
         on the left of the header, the view toggle and the primary action as a
         toolbar on the right, a rule under it, then the controls as the body.

         The hairline between the category and status groups is the fix for
         something that could not be solved while these floated free: with the
         `CATEGORY`/`STATUS` captions gone the two facets stopped reading as
         separate groups, and a free-standing divider stranded itself at the end
         of a wrapped line. Inside a panel it has a defined row to sit in, and
         it is hidden at the width where the row is known to wrap. */
    }
    <section class="studio-findbar" aria-labelledby="studio-findbar-title">
      <div class="studio-findbar-head">
        <div class="studio-findbar-heading">
          <h2 class="studio-findbar-title" id="studio-findbar-title">
            Find a book
          </h2>
          {
            /* The live result count, updated by the filter script. Visual only
               — the screen-reader announcement is the live region further down,
               and saying it twice would be worse than saying it once. */
          }
          <span
            class="studio-findbar-count"
            id="studio-findbar-count"
            aria-hidden="true">{totalCount} works</span
          >
          {
            /* Shown only while something is narrowed. A reset that is always
               there is a no-op most of the time, and a control that does
               nothing when pressed teaches you to distrust the row it sits in.
               `hidden` rather than disabled: there is no state to explain. */
          }
          <button
            type="button"
            class="studio-findbar-reset"
            id="studio-findbar-reset"
            hidden
          >
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            <span>Reset</span>
          </button>
        </div>
        <div class="studio-findbar-actions">
          {
            /* The three view modes, same three as the Library. One data attribute
               on the picker restyles the SAME cards — three markup branches would
               be three things to keep in step, and the compact tile and the list
               row are the full card with less shown, not different cards. */
          }
          <div
            class="studio-view-toggle"
            role="group"
            aria-label="Choose how books are shown"
          >
            <button
              type="button"
              class="studio-view-btn"
              data-view-mode="cards"
              aria-pressed="true"
              aria-label="Card view"
              title="Card view"
            >
              <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="studio-view-btn"
              data-view-mode="compact"
              aria-pressed="false"
              aria-label="Compact tile view"
              title="Compact tile view"
            >
              <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="studio-view-btn"
              data-view-mode="list"
              aria-pressed="false"
              aria-label="List view"
              title="List view"
            >
              <i class="fa-solid fa-list" aria-hidden="true"></i>
            </button>
          </div>
          <a
            class="studio-new-content-link"
            href="/studio/new"
            title="Scaffold a new book, lecture, or article"
          >
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span class="studio-new-content-label">New content</span>
          </a>
        </div>
      </div>

      <div class="studio-findbar-body">
        <div class="studio-toolbar-filters">
          <div
            class="studio-bucket-filter-bar"
            role="group"
            aria-label="Filter books by content category"
          >
            <button
              type="button"
              class="studio-bucket-chip"
              data-bucket-filter="all"
              aria-pressed="true"
              title="Every category"
            >
              <span class="studio-bucket-chip-label">All</span>
              <span class="studio-bucket-chip-count">{totalCount}</span>
            </button>
            {
              shelves.map(({ bucket, meta }) => (
                <button
                  type="button"
                  class="studio-bucket-chip"
                  data-bucket-filter={bucket}
                  aria-pressed="false"
                  title={meta.desc}
                  disabled={bucketCount(bucket) === 0}
                >
                  <i class={`fa-solid ${meta.icon}`} aria-hidden="true" />
                  <span class="studio-bucket-chip-label">{meta.chipLabel}</span>
                  <span class="studio-bucket-chip-count">
                    {bucketCount(bucket)}
                  </span>
                </button>
              ))
            }
          </div>
          <span class="studio-facet-sep" aria-hidden="true"></span>
          <div
            class="studio-filter-bar"
            role="group"
            aria-label="Filter books by lifecycle status"
          >
            <button
              type="button"
              class="studio-filter-chip"
              data-status-filter="all"
              aria-pressed="true"
              title="Every status"
            >
              <span class="studio-filter-chip-label">All</span>
              <span class="studio-filter-chip-count">{totalCount}</span>
            </button>
            {
              STATUS_FILTERS.map((f) => (
                <button
                  type="button"
                  class="studio-filter-chip"
                  data-status-filter={f.id}
                  aria-pressed="false"
                  title={f.hint}
                  disabled={statusCount(f.id) === 0}
                >
                  <i class={`fa-solid ${f.icon}`} aria-hidden="true" />
                  <span class="studio-filter-chip-label">{f.label}</span>
                  <span class="studio-filter-chip-count">
                    {statusCount(f.id)}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        {
          /* The counts are measured against the WHOLE shelf, never the filtered
             view: a number that renumbered itself as you filtered would flicker,
             and it is there to say what choosing it would give you. A track with
             none is DISABLED rather than dropped — the five tracks are a taxonomy
             worth seeing whole, and a row that changes length as books move
             through the pipeline teaches less than one that keeps its shape. */
        }
        <div class="studio-tracks-panel">
          <span class="studio-tracks-label" id="studio-tracks-label"
            >Browse by track</span
          >
          <div
            class="studio-track-filter-bar"
            role="group"
            aria-labelledby="studio-tracks-label"
          >
            <button
              type="button"
              class="studio-track-chip"
              data-track-filter="all"
              aria-pressed="true"
              title="Every track"
            >
              <span class="studio-track-chip-label">All tracks</span>
              <span class="studio-track-chip-count">{totalCount}</span>
            </button>
            {
              TRACK_FILTERS.map((f) => (
                <button
                  type="button"
                  class="studio-track-chip"
                  data-track-filter={f.id}
                  aria-pressed="false"
                  title={f.hint}
                  disabled={trackCount(f.id) === 0}
                >
                  <span class="studio-track-chip-label">{f.label}</span>
                  <span class="studio-track-chip-count">
                    {trackCount(f.id)}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      /* Filtering changes the page with no navigation, so the result is
         announced. `polite`, not `assertive`: it should be heard after the
         chip's own pressed state, not instead of it. */
    }
    <p
      id="studio-filter-status"
      class="sr-only"
      role="status"
      aria-live="polite"
    >
    </p>

    <div class="studio-shelves">
      {
        shelves.map(({ bucket, meta, items, cards: shelfCards }) => (
          <section class="studio-shelf" data-bucket={bucket}>
            <header class="studio-shelf-header">
              <span class="studio-shelf-icon-wrap" aria-hidden="true">
                <i class={`fa-solid ${meta.icon}`} />
              </span>
              <div class="studio-shelf-title-group">
                <h2 class="studio-shelf-name">{meta.label}</h2>
                <p class="studio-shelf-desc">{meta.desc}</p>
              </div>
              <span class="studio-shelf-count">
                {bucketCount(bucket)}{" "}
                {bucketCount(bucket) === 1 ? "work" : "works"}
              </span>
            </header>

            <div class="studio-shelf-floor-wrap">
              <div class="studio-shelf-grid">
                {items.map((it) =>
                  it.kind === "deck" ? (
                    <details class="studio-series-deck">
                      {/* The deck's status: decks are never hidden by a status
                          chip, because a series has no single status of its own
                          and its volumes each carry their own. Before this the
                          summary carried no `data-status` at all, so the filter
                          script read "" — never in the active set — and every
                          deck was hidden the first time any chip was toggled,
                          with no way to bring it back. */}
                      <summary
                        class="studio-picker-card studio-shelf-card studio-series-summary"
                        data-status="always"
                        data-track={it.deck.identity.studyTrack ?? ""}
                      >
                        <BookCard
                          identity={it.deck.identity}
                          countLabel={`${it.deck.volumes.length} volumes`}
                          statusLabel={it.deck.statusLabel}
                          steps={it.deck.steps}
                          chevron
                        />
                      </summary>
                      <ul class="studio-series-volumes">
                        {it.deck.volumes.map((v) => (
                          <li>
                            <a
                              class="studio-series-vol"
                              href={`/studio/${v.slug}`}
                              data-status={v.statusBucket}
                            >
                              <span
                                class="studio-series-vol-order"
                                aria-hidden="true"
                              >
                                {v.volumeOrder}
                              </span>
                              <span class="studio-series-vol-title">
                                {v.volumeLabel}
                              </span>
                              <span class="studio-series-vol-status">
                                {v.entry.label} · {v.entry.detail}
                              </span>
                              <span
                                class="studio-picker-bar"
                                aria-hidden="true"
                              >
                                {v.steps.map((s) => (
                                  <span
                                    class={`studio-picker-seg${s.state === "done" ? " is-done" : s.state === "active" ? " is-active" : s.state === "blocked" ? " is-blocked" : ""}`}
                                  />
                                ))}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a
                      class="studio-picker-card studio-shelf-card"
                      href={`/studio/${it.card.slug}`}
                      data-status={it.card.statusBucket}
                      data-track={it.card.identity.studyTrack ?? ""}
                    >
                      <BookCard
                        identity={it.card.identity}
                        pdfGenerated={it.card.pdfGenerated}
                        podcastGenerated={it.card.podcastGenerated}
                        podcastPlanned={it.card.podcastPlanned}
                        augmented={it.card.augmented}
                        countLabel={
                          it.card.episodeCount > 0
                            ? `${it.card.episodeCount} episodes`
                            : ""
                        }
                        statusLabel={`${it.card.entry.label} · ${it.card.entry.detail}`}
                        steps={it.card.steps}
                      />
                    </a>
                  ),
                )}
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<script>
  /**
   * Studio picker filters — THREE single-select facets that narrow together.
   *
   * Category, lifecycle status and subject track. Each has an explicit "All"
   * chip, each starts on "All", and choosing one option in a group deselects
   * the others in that group. A card shows when it satisfies ALL THREE.
   *
   * This replaces a multi-select model in which every chip started ON, so a
   * click SUBTRACTED: pressing "Published" hid the published books. The
   * pressed styling compounded it — the chip you had just switched off drew as
   * the prominent one — so the interface confirmed the wrong reading.
   *
   * The chosen facets are remembered, matching the Library's find row: coming
   * back to a shelf you narrowed and finding it wide again loses the only
   * state this page has.
   */
  type Facet = "bucket" | "status" | "track";

  const STORAGE_KEY = "pf-studio-filters";

  /** Every group, and how a card declares the value that group tests. */
  const GROUPS: Record<
    Facet,
    { chip: string; attr: string; cardValue: (card: HTMLElement) => string }
  > = {
    bucket: {
      chip: ".studio-bucket-chip",
      attr: "bucketFilter",
      // A card's bucket is its SHELF's, not its own — the shelf is the group.
      cardValue: (card) =>
        card.closest<HTMLElement>(".studio-shelf")?.dataset.bucket ?? "",
    },
    status: {
      chip: ".studio-filter-chip",
      attr: "statusFilter",
      cardValue: (card) => card.dataset.status ?? "",
    },
    track: {
      chip: ".studio-track-chip",
      attr: "trackFilter",
      cardValue: (card) => card.dataset.track ?? "",
    },
  };

  const chipsIn = (facet: Facet) =>
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(GROUPS[facet].chip),
    );

  const valueOf = (facet: Facet, chip: HTMLButtonElement) =>
    chip.dataset[GROUPS[facet].attr] ?? "all";

  /** The current choice per facet. "all" is the default and the reset value. */
  const chosen: Record<Facet, string> = {
    bucket: "all",
    status: "all",
    track: "all",
  };

  function restore(): void {
    let saved: unknown;
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}");
    } catch {
      return; // Unreadable or unavailable storage just means the defaults.
    }
    if (!saved || typeof saved !== "object") return;
    for (const facet of Object.keys(GROUPS) as Facet[]) {
      const want = (saved as Record<string, unknown>)[facet];
      if (typeof want !== "string") continue;
      // Only restore a choice this page can still honour: a track whose books
      // have all been republished elsewhere, or a bucket that no longer has a
      // shelf, would otherwise restore an empty screen with no way back except
      // finding a chip that is not there.
      const chip = chipsIn(facet).find((c) => valueOf(facet, c) === want);
      if (chip && !chip.disabled) chosen[facet] = want;
    }
  }

  function persist(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(chosen));
    } catch {
      /* Private browsing or a full quota — the filters still work this visit. */
    }
  }

  function paintChips(): void {
    for (const facet of Object.keys(GROUPS) as Facet[]) {
      for (const chip of chipsIn(facet)) {
        chip.setAttribute(
          "aria-pressed",
          valueOf(facet, chip) === chosen[facet] ? "true" : "false",
        );
      }
    }
  }

  /** Does this card satisfy ONE facet's value? `all` matches everything. */
  function satisfies(card: HTMLElement, facet: Facet, want: string): boolean {
    if (want === "all") return true;
    // A series deck has no single status of its own — its volumes each carry
    // theirs — so it is never hidden by the status facet. Without this the
    // deck vanished on the first status click with no way to bring it back.
    const value = GROUPS[facet].cardValue(card);
    if (facet === "status" && value === "always") return true;
    return value === want;
  }

  function matches(card: HTMLElement): boolean {
    return (Object.keys(GROUPS) as Facet[]).every((facet) =>
      satisfies(card, facet, chosen[facet]),
    );
  }

  /** Every card on the page, hidden or not — the population the counts are
   *  measured over. Read once per pass rather than per chip. */
  const allCards = () =>
    Array.from(document.querySelectorAll<HTMLElement>(".studio-shelf-card"));

  /**
   * Recount every chip AGAINST THE OTHER FACETS' CURRENT CHOICES.
   *
   * The counts used to be computed once, server-side, each facet measured over
   * the whole shelf in isolation. That is right only while the other two facets
   * are on "All", and wrong the moment they are not: with Published chosen,
   * "Shariah 2" promised two books and delivered NONE, because no Shariah book
   * is published. A chip whose number cannot be produced by pressing it is
   * worse than a chip with no number, and the earlier fix — measuring over what
   * the shelf DRAWS rather than over raw volumes — corrected the arithmetic
   * while leaving this, the actual lie, in place.
   *
   * So a chip now reports what pressing it WOULD show given everything else
   * already chosen, and a chip that would show nothing is disabled. That makes
   * the promise structurally true rather than true-by-inspection: the number
   * and the outcome are computed from the same predicate over the same cards.
   *
   * The chip's OWN facet is excluded from its test — including it would make
   * every unchosen chip in a narrowed group report zero.
   */
  function recount(): void {
    const cards = allCards();
    for (const facet of Object.keys(GROUPS) as Facet[]) {
      const others = (Object.keys(GROUPS) as Facet[]).filter(
        (f) => f !== facet,
      );
      const eligible = cards.filter((card) =>
        others.every((f) => satisfies(card, f, chosen[f])),
      );
      for (const chip of chipsIn(facet)) {
        const value = valueOf(facet, chip);
        // An "All" chip CLEARS EVERY FACET, so what it will show is the whole
        // shelf — not the contextual figure the other chips report. Counting it
        // like them made it read "All 2" and then show 13, which is the same
        // broken promise this whole mechanism exists to prevent, introduced by
        // the change that gave "All" its wider meaning. Caught by INV-8 within
        // a minute of making it.
        const n =
          value === "all"
            ? cards.length
            : eligible.filter((card) => satisfies(card, facet, value)).length;
        const slot = chip.querySelector<HTMLElement>("[class$='-count']");
        if (slot) slot.textContent = String(n);
        // The CHOSEN chip is never disabled even at zero — it is the one that
        // got you to an empty shelf, and disabling it would take away the
        // control you need to leave. Everything else at zero goes flat.
        chip.disabled = n === 0 && value !== chosen[facet];
      }
    }
  }

  function apply(): void {
    document.querySelectorAll<HTMLElement>(".studio-shelf").forEach((shelf) => {
      let visible = 0;
      shelf
        .querySelectorAll<HTMLElement>(".studio-shelf-card")
        .forEach((card) => {
          const show = matches(card);
          card.hidden = !show;
          // A deck's card is its `<summary>`, but the stacked-sheet shell drawn
          // around it is the `<details>`. Hiding only the summary left that
          // shell holding a grid cell as an empty bordered panel — visible the
          // moment the track facet arrived, since a track is the first facet
          // that can hide one deck while its shelf-mates stay. Both are hidden,
          // not just the wrapper, so the counts below still read the cards.
          const deck = card.closest<HTMLElement>(".studio-series-deck");
          if (deck) deck.hidden = !show;
          if (show) visible += 1;
        });
      // Volume rows inside an open deck follow the same rules, so a facet
      // narrows what the deck lists rather than leaving stale rows on screen.
      // They DO carry their own status, unlike the deck summary above them.
      shelf
        .querySelectorAll<HTMLElement>(".studio-series-vol")
        .forEach((row) => {
          row.hidden = !matches(row);
        });
      shelf.hidden = visible === 0;
      const count = shelf.querySelector<HTMLElement>(".studio-shelf-count");
      if (count)
        count.textContent = `${visible} ${visible === 1 ? "work" : "works"}`;
    });

    // Said out loud, because filtering happens with no page change: without it
    // a screen-reader user presses a chip and is told nothing at all.
    // The find bar's own count, kept in step with the shelves. Visual only —
    // the live region below is what is announced, and doing both would say the
    // same number twice.
    const headCount = document.getElementById("studio-findbar-count");
    if (headCount) {
      const shown = document.querySelectorAll<HTMLElement>(
        ".studio-shelf-card:not([hidden])",
      ).length;
      headCount.textContent = `${shown} ${shown === 1 ? "work" : "works"}`;
    }

    const status = document.getElementById("studio-filter-status");
    if (status) {
      const shown = document.querySelectorAll<HTMLElement>(
        ".studio-shelf-card:not([hidden])",
      ).length;
      const wide = Object.values(chosen).every((v) => v === "all");
      status.textContent = wide
        ? `Showing all ${shown} works.`
        : `Showing ${shown} ${shown === 1 ? "work" : "works"}.`;
    }
  }

  /** Every facet back to "All" — the page as it arrives. */
  function resetAll(): void {
    for (const facet of Object.keys(GROUPS) as Facet[]) chosen[facet] = "all";
  }

  const isWide = () => Object.values(chosen).every((v) => v === "all");

  function refresh(): void {
    paintChips();
    recount();
    apply();
    persist();
    // The reset control appears only while something is narrowed.
    const reset = document.getElementById("studio-findbar-reset");
    if (reset) reset.hidden = isWide();
  }

  for (const facet of Object.keys(GROUPS) as Facet[]) {
    for (const chip of chipsIn(facet)) {
      chip.addEventListener("click", () => {
        const value = valueOf(facet, chip);
        // "All" in ANY group clears EVERY facet, not just its own (Asif,
        // 2026-08-15). Three separate "All" chips that each cleared only their
        // own row meant getting back to the whole shelf could take three
        // presses, and there was no single control that said "start again" —
        // which is the state you want most often after a filter shows you
        // nothing. Pressing one now IS starting again.
        if (value === "all") resetAll();
        else chosen[facet] = value;
        refresh();
      });
    }
  }

  document
    .getElementById("studio-findbar-reset")
    ?.addEventListener("click", () => {
      resetAll();
      refresh();
    });

  /**
   * View mode — cards / compact / list, the same three the Library offers.
   *
   * One data attribute on the picker; the stylesheet does the rest. Kept apart
   * from the facets above because it answers a different question: the facets
   * decide WHICH books are on screen, this decides how much of each is drawn.
   * It is remembered separately for the same reason.
   */
  const VIEW_KEY = "pf-studio-view";
  const VIEWS = ["cards", "compact", "list"] as const;
  type View = (typeof VIEWS)[number];

  const picker = document.querySelector<HTMLElement>(".studio-picker");
  const viewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".studio-view-btn"),
  );

  function setView(view: View, save: boolean): void {
    if (picker) picker.dataset.view = view;
    for (const b of viewButtons) {
      b.setAttribute(
        "aria-pressed",
        b.dataset.viewMode === view ? "true" : "false",
      );
    }
    if (!save) return;
    try {
      localStorage.setItem(VIEW_KEY, view);
    } catch {
      /* Storage unavailable — the choice still holds for this visit. */
    }
  }

  for (const b of viewButtons) {
    b.addEventListener("click", () => {
      const view = b.dataset.viewMode as View | undefined;
      if (view && (VIEWS as readonly string[]).includes(view))
        setView(view, true);
    });
  }

  let savedView: string | null = null;
  try {
    savedView = localStorage.getItem(VIEW_KEY);
  } catch {
    /* see above */
  }
  setView(
    (VIEWS as readonly string[]).includes(savedView ?? "")
      ? (savedView as View)
      : "cards",
    false,
  );

  restore();
  refresh();
</script>
