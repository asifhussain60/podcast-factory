---
/**
 * Studio pipeline — one book, one step. The sequential content workflow:
 *   /studio/<slug>/intake | review | edit | publish
 *
 * The book is in the URL (global selection); the StudioSubnav stepper carries
 * the operator through the four steps with live status. Each step mounts the
 * surface that owns that stage of the real pipeline.
 */
import Base from '../../../layouts/Base.astro';
import StudioSubnav from '../../../components/studio/StudioSubnav.astro';
import OperatorWorkbench from '../../../components/workbench/OperatorWorkbench.tsx';
import EditorialCards from '../../../components/reader/poc/EditorialCards.tsx';
import ContentLevelSelector from '../../../components/studio/ContentLevelSelector.tsx';
import StudioPoc from '../../../components/reader/poc/StudioPoc.tsx';
import { CARD_DEFS } from '../../../lib/reader/editorial';
import { loadBookIndex } from '../../../lib/reader/chapters';
import { loadBookWorkspace, AYYUHAL_WALAD_STAGE_DEFS } from '../../../lib/reader/book-workspace';
import { loadStudioPipeline, STUDIO_STEPS, type StepId } from '../../../lib/reader/studio-pipeline';
import { findContent, listContent, slugToTitle } from '../../../lib/content-paths';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import '../../../styles/corpus-mock.css';
import '../../../styles/studio-poc.css';
import '../../../styles/workbench.css';
import '../../../styles/studio-pipeline.css';

const VALID_STEPS: StepId[] = STUDIO_STEPS.map((s) => s.id);

const slug = Astro.params.slug!;
const stepParam = Astro.params.step as StepId;

const ref = await findContent(slug);
if (!ref) return Astro.redirect('/studio');
if (!VALID_STEPS.includes(stepParam)) return Astro.redirect(`/studio/${slug}/edit`);

const bookTitle = slugToTitle(slug);
const steps = await loadStudioPipeline(slug);

// Book selector options — all books in the workshop.
const allBooks = await listContent({ category: 'books' });
const books = allBooks.map((b) => ({ slug: b.slug, title: slugToTitle(b.slug) }));

// Shared loads for steps that need chapter data.
const index = await loadBookIndex(slug);
const chapterDefs = (index?.chapters ?? []).map((c) => ({ id: c.slug, title: c.title }));
const workspace = await loadBookWorkspace(slug, chapterDefs, AYYUHAL_WALAD_STAGE_DEFS);

// ?ch= param — deep-link from Library chapter reader (R-1 toggle).
// Pre-selects the specific chapter in the cockpit on arrival.
const chParam = Astro.url.searchParams.get('ch') ?? '';
const initialChapterId = chapterDefs.find((c) => c.id === chParam)?.id ?? chapterDefs[0]?.id ?? '';
// Index of the deep-linked chapter within the workspace (StudioPoc takes an index).
const initialChapIdx = Math.max(0, workspace.chapters.findIndex((c) => c.slug === initialChapterId));
// ?view=workbench keeps the pipeline-review OperatorWorkbench reachable; the rich
// StudioPoc editor is the default edit surface (shows the full stage history).
const editView = Astro.url.searchParams.get('view') === 'workbench' ? 'workbench' : 'editor';

// Wave L-7 — content-level selector data. Read tradition_affinity + content_level
// from meta.yml; the selector is shown ONLY for Islamic books (tradition_affinity set).
let bookTradition = '';
let bookContentLevel = '';
try {
  const metaRaw = await readFile(join(ref.dir, 'meta.yml'), 'utf-8');
  const tradMatch = metaRaw.match(/^tradition_affinity:\s*(.+)$/m);
  const levelMatch = metaRaw.match(/^content_level:\s*(.+)$/m);
  bookTradition = tradMatch ? tradMatch[1].trim() : '';
  bookContentLevel = levelMatch ? levelMatch[1].trim() : '';
} catch { /* no meta.yml — selector hidden */ }
const showContentLevel = bookTradition !== '' && bookTradition !== 'universal';

// Depth-level picker profile — read from series-config.yaml; defaults to islamic_scholarly.
let contentProfile = 'islamic_scholarly';
try {
  const cfgRaw = await readFile(join(ref.dir, '_system', 'series-config.yaml'), 'utf-8');
  const cpMatch = cfgRaw.match(/^content_profile:\s*(\S+)/m);
  if (cpMatch) contentProfile = cpMatch[1];
} catch { /* no series-config.yaml — default applies */ }

// Review-gate (for the review step).
let gate: { approved?: boolean; warnings?: { severity?: string; message?: string }[] } | null = null;
if (stepParam === 'review') {
  try {
    gate = JSON.parse(await readFile(join(ref.dir, '_system', 'review-gate.json'), 'utf-8'));
  } catch { gate = null; }
}
const p0 = (gate?.warnings ?? []).filter((w) => w?.severity === 'P0');
const p1 = (gate?.warnings ?? []).filter((w) => w?.severity === 'P1');

const stepMeta = STUDIO_STEPS.find((s) => s.id === stepParam)!;
const pageTitle = `${stepMeta.label} — ${bookTitle}`;
---
<Base title={pageTitle} active="studio" description={`Studio · ${stepMeta.label} · ${bookTitle}`}>
  <StudioSubnav slot="subnav" slug={slug} bookTitle={bookTitle} activeStep={stepParam} steps={steps} books={books} />

  {/* ── Intake ──────────────────────────────────────────── */}
  {stepParam === 'intake' && (
    <div class="studio-step-body">
      <header class="studio-step-head">
        <h1>Intake — {bookTitle}</h1>
        <p>{stepMeta.blurb} These editorial decisions steer how every later stage authors the book.</p>
      </header>
      {showContentLevel && (
        <div class="studio-panel">
          <h2>Content level</h2>
          <p class="cl-intro">
            Sets which wisdom-corpus teachings may enrich this book. A book draws
            only from its own level and the levels below it — never above. Quran,
            hadith, and etymology are always available regardless of level.
          </p>
          <ContentLevelSelector client:only="react" slug={slug} initial={bookContentLevel} />
        </div>
      )}
      <div class="studio-panel">
        <h2>Editorial decisions</h2>
        <EditorialCards client:only="react" slug={slug} chapters={workspace.cockpitChapters} cardDefs={CARD_DEFS} />
      </div>
    </div>
  )}

  {/* ── Source Review ───────────────────────────────────── */}
  {stepParam === 'review' && (
    <div class="studio-step-body">
      <header class="studio-step-head">
        <h1>Source Review — {bookTitle}</h1>
        <p>{stepMeta.blurb}</p>
      </header>
      {gate ? (
        <div class="studio-panel">
          <p>
            <span class={`studio-gate-pill ${gate.approved ? 'is-approved' : p0.length ? 'is-blocked' : 'is-pending'}`}>
              {gate.approved ? 'Approved' : p0.length ? `${p0.length} blocking` : 'Awaiting approval'}
            </span>
          </p>
          {p0.length > 0 && (
            <ul>{p0.map((w) => <li>{w.message ?? 'P0 issue'}</li>)}</ul>
          )}
          {p1.length > 0 && (
            <ul>{p1.map((w) => <li>{w.message ?? 'P1 note'}</li>)}</ul>
          )}
          {p0.length === 0 && p1.length === 0 && <p>No outstanding warnings.</p>}
        </div>
      ) : (
        <div class="studio-panel">
          <h2>No review gate yet</h2>
          <p>The source review gate is produced in pipeline phase 06a. Once the orchestrator reaches that phase, the approval controls appear here.</p>
        </div>
      )}
    </div>
  )}

  {/* ── Edit & Enrich (the merged cockpit) ──────────────── */}
  {stepParam === 'edit' && (
    <div class="studio-step-body">
      {workspace.loadError ? (
        <div class="studio-panel"><p>{workspace.loadError}</p></div>
      ) : editView === 'workbench' ? (
        <>
          <nav class="studio-editview-toggle" aria-label="Edit surface">
            <a href={`/studio/${slug}/edit`}>← Rich editor</a>
            <span class="is-current">Pipeline workbench</span>
          </nav>
          <OperatorWorkbench
            client:only="react"
            slug={workspace.slug}
            bookTitle={bookTitle}
            chapters={workspace.chapters}
            chapterDefs={workspace.cockpitChapters}
            cardDefs={CARD_DEFS}
            initialChapterId={initialChapterId}
          />
        </>
      ) : (
        <>
          <nav class="studio-editview-toggle" aria-label="Edit surface">
            <span class="is-current">Rich editor</span>
            <a href={`/studio/${slug}/edit?view=workbench`}>Pipeline workbench →</a>
          </nav>
          <StudioPoc
            client:only="react"
            slug={workspace.slug}
            chapters={workspace.chapters}
            glossary={workspace.glossary}
            initialChapIdx={initialChapIdx}
            contentProfile={contentProfile}
          />
        </>
      )}
    </div>
  )}

  {/* ── Publish ─────────────────────────────────────────── */}
  {stepParam === 'publish' && (
    <div class="studio-step-body">
      <header class="studio-step-head">
        <h1>Publish — {bookTitle}</h1>
        <p>{stepMeta.blurb}</p>
      </header>
      <div class="studio-panel">
        <h2>{steps[3].detail}</h2>
        <p>
          Publishing promotes the finalized book from the workshop to the published catalog.
          It runs gates G1–G7 and is an explicit, reviewed step — start it from Claude Code with
          the publisher once you are satisfied with the finalized version.
        </p>
      </div>
    </div>
  )}
</Base>
