---
/**
 * Studio pipeline — one book, one step. The sequential content workflow:
 *   /studio/<slug>/intake | review | edit | publish
 *
 * The book is in the URL (global selection); the StudioSubnav stepper carries
 * the operator through the four steps with live status. Each step mounts the
 * surface that owns that stage of the real pipeline.
 */
import Base from "../../../layouts/Base.astro";
import StudioSubnav from "../../../components/studio/StudioSubnav.astro";
import OperatorWorkbench from "../../../components/workbench/OperatorWorkbench.tsx";
import EditorialCards from "../../../components/studio/editor/EditorialCards.tsx";
import ContentLevelSelector from "../../../components/studio/ContentLevelSelector.tsx";
import StudioEditor from "../../../components/studio/editor/StudioEditor.tsx";
import { CARD_DEFS } from "../../../lib/reader/editorial";
import { loadBookIndex } from "../../../lib/reader/chapters";
import {
  loadBookWorkspace,
  discoverArchivedLineages,
  STAGE_DEFS,
} from "../../../lib/reader/book-workspace";
import { loadEnrichment } from "../../../lib/reader/enrichment-ledger";
import {
  loadStudioPipeline,
  STUDIO_STEPS,
  type StepId,
} from "../../../lib/reader/studio-pipeline";
import {
  findContent,
  listContent,
  slugToTitle,
} from "../../../lib/content-paths";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import "../../../styles/corpus.css";
import "../../../styles/editor-fonts.css";
import "../../../styles/studio-editor.css";
import "../../../styles/stage-timeline.css";
import "../../../styles/transformation-dashboard.css";
import "../../../styles/workbench.css";
import "../../../styles/studio-pipeline.css";

const VALID_STEPS: StepId[] = STUDIO_STEPS.map((s) => s.id);

const slug = Astro.params.slug!;
const stepParam = Astro.params.step as StepId;

const ref = await findContent(slug);
if (!ref) return Astro.redirect("/studio");
if (!VALID_STEPS.includes(stepParam))
  return Astro.redirect(`/studio/${slug}/edit`);

const bookTitle = slugToTitle(slug);
const steps = await loadStudioPipeline(slug);

// Book selector options — all books in the workshop.
const allBooks = await listContent({ category: "books" });
const books = allBooks.map((b) => ({
  slug: b.slug,
  title: slugToTitle(b.slug),
}));

// Shared loads for steps that need chapter data.
const index = await loadBookIndex(slug);
const chapterDefs = (index?.chapters ?? []).map((c) => ({
  id: c.slug,
  title: c.title,
}));
const workspace = await loadBookWorkspace(slug, chapterDefs, STAGE_DEFS);
// Book-level enrichment summary (Phase 0e) for the transformation dashboard.
const enrichment = loadEnrichment(slug);

// View-only progression lineages: any archived full-stage run for this book
// (e.g. an earlier episode structure). Loaded with writeLedger:false so they
// never clobber the live book's stage-metrics.json.
const archivedLineages = discoverArchivedLineages(slug);
const archivedWorkspaces = await Promise.all(
  archivedLineages.map((ln) =>
    loadBookWorkspace(slug, ln.chapters, STAGE_DEFS, {
      stageRoot: ln.stageRoot,
      writeLedger: false,
    }),
  ),
);
const progressionArchives = archivedLineages.map((ln, i) => ({
  id: ln.id,
  label: ln.label,
  chapters: archivedWorkspaces[i].chapters,
}));

// ?ch= param — deep-link from Library chapter reader (R-1 toggle).
// Pre-selects the specific chapter in the cockpit on arrival.
const chParam = Astro.url.searchParams.get("ch") ?? "";
const initialChapterId =
  chapterDefs.find((c) => c.id === chParam)?.id ?? chapterDefs[0]?.id ?? "";
// Index of the deep-linked chapter within the workspace (StudioEditor takes an index).
const initialChapIdx = Math.max(
  0,
  workspace.chapters.findIndex((c) => c.slug === initialChapterId),
);
// ?view=workbench keeps the pipeline-review OperatorWorkbench reachable; the rich
// StudioEditor editor is the default edit surface (shows the full stage history).
const editView =
  Astro.url.searchParams.get("view") === "workbench" ? "workbench" : "editor";

// Wave L-7 — content-level selector data. Read tradition_affinity + content_level
// from meta.yml; the selector is shown ONLY for Islamic books (tradition_affinity set).
let bookTradition = "";
let bookContentLevel = "";
try {
  const metaRaw = await readFile(join(ref.dir, "meta.yml"), "utf-8");
  const tradMatch = metaRaw.match(/^tradition_affinity:\s*(.+)$/m);
  const levelMatch = metaRaw.match(/^content_level:\s*(.+)$/m);
  bookTradition = tradMatch ? tradMatch[1].trim() : "";
  bookContentLevel = levelMatch ? levelMatch[1].trim() : "";
} catch {
  /* no meta.yml — selector hidden */
}
const showContentLevel = bookTradition !== "" && bookTradition !== "universal";

// Depth-level picker profile — read from series-config.yaml; defaults to islamic_scholarly.
// Audio Engine v2: the same read resolves the book's audio engine (default notebooklm).
let contentProfile = "islamic_scholarly";
let audioEngine = "notebooklm";
try {
  const cfgRaw = await readFile(
    join(ref.dir, "_system", "series-config.yaml"),
    "utf-8",
  );
  const cpMatch = cfgRaw.match(/^content_profile:\s*(\S+)/m);
  if (cpMatch) contentProfile = cpMatch[1];
  const aeMatch = cfgRaw.match(/^audio_engine:\s*(\S+)/m);
  if (aeMatch) audioEngine = aeMatch[1];
} catch {
  /* no series-config.yaml — default applies */
}

// Audio Engine v2 — rendered-credit spend from the cost ledger (publish step).
// ElevenLabs rows store exact metered credits in input_tokens (see
// scripts/podcast/_cost_ledger.py::append_elevenlabs_cost).
let renderedCredits = 0;
let renderedUsd = 0;
if (stepParam === "publish") {
  try {
    const ledgerRaw = await readFile(
      join(ref.dir, "_system", "cost-ledger.jsonl"),
      "utf-8",
    );
    for (const line of ledgerRaw.split("\n")) {
      if (!line.trim()) continue;
      try {
        const row = JSON.parse(line);
        if (row.model === "elevenlabs-eleven-v3") {
          renderedCredits += Number(row.input_tokens) || 0;
          renderedUsd += Number(row.cost_usd) || 0;
        }
      } catch {
        /* skip malformed row */
      }
    }
  } catch {
    /* no ledger yet */
  }
}

// Review-gate (for the review step).
let gate: {
  approved?: boolean;
  warnings?: { severity?: string; message?: string }[];
} | null = null;
if (stepParam === "review") {
  try {
    gate = JSON.parse(
      await readFile(join(ref.dir, "_system", "review-gate.json"), "utf-8"),
    );
  } catch {
    gate = null;
  }
}
const p0 = (gate?.warnings ?? []).filter((w) => w?.severity === "P0");
const p1 = (gate?.warnings ?? []).filter((w) => w?.severity === "P1");

const stepMeta = STUDIO_STEPS.find((s) => s.id === stepParam)!;
const pageTitle = `${stepMeta.label} — ${bookTitle}`;
---

<Base
  title={pageTitle}
  active="studio-book"
  description={`Studio · ${stepMeta.label} · ${bookTitle}`}
>
  <StudioSubnav
    slot="subnav"
    slug={slug}
    bookTitle={bookTitle}
    activeStep={stepParam}
    steps={steps}
    books={books}
    compact={stepParam === "edit"}
  />

  {/* ── Intake ──────────────────────────────────────────── */}
  {
    stepParam === "intake" && (
      <div class="studio-step-body">
        <header class="studio-step-head">
          <h1>Intake — {bookTitle}</h1>
          <p>
            {stepMeta.blurb} These editorial decisions steer how every later
            stage authors the book.
          </p>
        </header>
        {showContentLevel && (
          <div class="studio-panel">
            <h2>Content level</h2>
            <p class="cl-intro">
              Sets which wisdom-corpus teachings may enrich this book. A book
              draws only from its own level and the levels below it — never
              above. Quran, hadith, and etymology are always available
              regardless of level.
            </p>
            <ContentLevelSelector
              client:only="react"
              slug={slug}
              initial={bookContentLevel}
            />
          </div>
        )}
        <div class="studio-panel">
          <h2>Editorial decisions</h2>
          <EditorialCards
            client:only="react"
            slug={slug}
            chapters={workspace.cockpitChapters}
            cardDefs={CARD_DEFS}
          />
        </div>
      </div>
    )
  }

  {/* ── Source Review ───────────────────────────────────── */}
  {
    stepParam === "review" && (
      <div class="studio-step-body">
        <header class="studio-step-head">
          <h1>Source Review — {bookTitle}</h1>
          <p>{stepMeta.blurb}</p>
        </header>
        {gate ? (
          <div class="studio-panel">
            <p>
              <span
                class={`studio-gate-pill ${gate.approved ? "is-approved" : p0.length ? "is-blocked" : "is-pending"}`}
              >
                {gate.approved
                  ? "Approved"
                  : p0.length
                    ? `${p0.length} blocking`
                    : "Awaiting approval"}
              </span>
            </p>
            {p0.length > 0 && (
              <ul>
                {p0.map((w) => (
                  <li>{w.message ?? "P0 issue"}</li>
                ))}
              </ul>
            )}
            {p1.length > 0 && (
              <ul>
                {p1.map((w) => (
                  <li>{w.message ?? "P1 note"}</li>
                ))}
              </ul>
            )}
            {p0.length === 0 && p1.length === 0 && (
              <p>No outstanding warnings.</p>
            )}
          </div>
        ) : (
          <div class="studio-panel">
            <h2>No review gate yet</h2>
            <p>
              The source review gate is produced in pipeline phase 06a. Once the
              orchestrator reaches that phase, the approval controls appear
              here.
            </p>
          </div>
        )}
      </div>
    )
  }

  {/* ── Edit & Enrich (the merged cockpit) ──────────────── */}
  {
    stepParam === "edit" && (
      <div class="studio-step-body studio-step-body--wide">
        {workspace.loadError ? (
          <>
            <header class="studio-step-head">
              <h1>Edit &amp; Enrich — {bookTitle}</h1>
            </header>
            <div class="studio-panel">
              <h2>No chapters to edit yet</h2>
              <p>
                This book hasn’t been segmented into chapters, so the Edit &amp;
                Enrich cockpit has nothing to show — chapters are produced later
                in the pipeline (phase 0d), and there are no stage artifacts
                before then.
              </p>
              <p>
                Its source content — the transcripts, the refined reading
                edition, and audits — is ready to read now in the{" "}
                <a href={`/studio/${slug}`}>content reader</a>.
              </p>
            </div>
          </>
        ) : editView === "workbench" ? (
          <>
            <nav class="studio-editview-toggle" aria-label="Edit surface">
              <a href={`/studio/${slug}/edit`}>← Rich editor</a>
              <span class="is-current">Pipeline workbench</span>
            </nav>
            <OperatorWorkbench
              client:only="react"
              slug={workspace.slug}
              bookTitle={bookTitle}
              chapters={workspace.chapters}
              chapterDefs={workspace.cockpitChapters}
              cardDefs={CARD_DEFS}
              initialChapterId={initialChapterId}
            />
          </>
        ) : (
          <>
            <nav class="studio-editview-toggle" aria-label="Edit surface">
              <span class="is-current">Rich editor</span>
              {/* The third link here was "Arabic review →", to
                  /studio/<slug>/arabic-review. That page was retired in 2026-07
                  and redirects to the Composer, whose Arabic drawer surface was
                  removed on 2026-07-29 — so the link led to a panel that is no
                  longer anywhere. Removed with it. */}
              <a href={`/studio/${slug}/edit?view=workbench`}>
                Pipeline workbench
              </a>
            </nav>
            <StudioEditor
              client:only="react"
              slug={workspace.slug}
              chapters={workspace.chapters}
              glossary={workspace.glossary}
              glossaryAll={workspace.glossaryAll}
              initialChapIdx={initialChapIdx}
              hasChapterDeepLink={!!chParam}
              contentProfile={contentProfile}
              archivedLineages={progressionArchives}
              pipelineSteps={steps}
              activeStep={stepParam}
              enrichment={enrichment}
              glossaryCount={workspace.glossary.length}
            />
          </>
        )}
      </div>
    )
  }

  {/* ── Publish ─────────────────────────────────────────── */}
  {
    stepParam === "publish" && (
      <div class="studio-step-body">
        <header class="studio-step-head">
          <h1>Publish — {bookTitle}</h1>
          <p>{stepMeta.blurb}</p>
        </header>
        <div class="studio-panel">
          <h2>{steps[3].detail}</h2>
          <p>
            Publishing promotes the finalized book from the workshop to the
            published catalog. It runs gates G1–G7 and is an explicit, reviewed
            step — start it from Claude Code with the publisher once you are
            satisfied with the finalized version.
          </p>
        </div>
        <div class="studio-panel">
          <h2>Audio engine</h2>
          <dl class="studio-audio-meta">
            <div class="studio-audio-meta-row">
              <dt>Engine</dt>
              <dd>
                {audioEngine === "elevenlabs"
                  ? "ElevenLabs — autonomous render (eleven_v3)"
                  : "NotebookLM — manual upload and download"}
              </dd>
            </div>
            {audioEngine === "elevenlabs" && (
              <div class="studio-audio-meta-row">
                <dt>Rendered credits</dt>
                <dd>
                  {renderedCredits.toLocaleString()} credits
                  {renderedUsd > 0 &&
                    ` (~$${renderedUsd.toFixed(2)} plan value)`}
                </dd>
              </div>
            )}
          </dl>
          <p class="studio-audio-meta-note">
            {audioEngine === "elevenlabs"
              ? "Exact metered synthesis spend from the book’s cost ledger. Unchanged chapters never re-render or re-spend."
              : "This book uses the manual NotebookLM path; no synthesis credits are spent."}
          </p>
        </div>
      </div>
    )
  }
</Base>
