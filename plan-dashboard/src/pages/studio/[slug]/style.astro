---
/**
 * Studio — Citation & Quote style picker (Book Pipeline v2).
 *
 * /studio/<slug>/style — choose ONE global family (Plain / Scholarly / Elegant)
 * that skins every special passage in the printed reading edition: Quran verses,
 * hadith, poetry, sayings, quotations, and inline Arabic. The three chips drive a
 * single live preview via CSS :has() (JS-free rendering); the small client only
 * persists the choice to book/citation-style.json and reflects the saved value on
 * load. render-book-pdf.mjs reads that file and stamps body.style-<family> so the
 * PDF renders in the chosen family.
 */
import Base from "../../../layouts/Base.astro";
import { slugToTitle } from "../../../lib/content-paths";
import "../../../styles/library.css";
import "../../../styles/book-styles.css";

const slug = Astro.params.slug!;
const bookTitle = slugToTitle(slug);

// Simple → elegant. `scholarly` is the current book-print default (pre-checked;
// the client re-selects whatever was previously saved once the page loads).
const FAMILIES = [
  {
    id: "plain",
    name: "Plain",
    tagline: "Quietest — no ornament",
    blurb:
      "Every passage is set in plain black ink — no borders, no tint, no frames. Arabic and translation sit cleanly in the flow; nothing interrupts the page. Maximum readability.",
  },
  {
    id: "scholarly",
    name: "Scholarly",
    tagline: "Restrained — current default",
    blurb:
      "A slim rule beside each passage — gold for a verse, accent for a hadith — with Amiri at reading scale and a muted translation. The woven academic convention.",
  },
  {
    id: "elegant",
    name: "Elegant",
    tagline: "Framed & editorial",
    blurb:
      "Verses and hadith sit in softly framed panels with fine gold detailing and an end-of-ayah marker; quotations carry a display quote-mark; poetry is flanked by a small ornament. Centered and formal.",
  },
];
---

<Base
  title={`Citation styles — ${bookTitle}`}
  active="studio"
  description={`Studio · Citation & quote styles · ${bookTitle}`}
>
  <header class="lib-hero">
    <div class="lib-hero-main">
      <div class="lib-breadcrumb">
        <a href="/studio">Studio</a>
        <span class="lib-sep">›</span>
        <span>Citation styles</span>
      </div>
      <div class="lib-title-row"><h1>{bookTitle}</h1></div>
      <p class="bs-lede">
        Choose one style family for the whole book. It sets how every special
        passage — Quran verses, hadith, poetry, sayings, quotations, and inline
        Arabic — appears in the printed reading edition. Pick a family to
        preview the full set; your choice is saved and drives Generate&nbsp;PDF.
      </p>
    </div>
    <div class="lib-hero-aside">
      <div class="lib-title-actions">
        <a class="lib-studio-link" href={`/studio/${slug}/compose`}>
          <i class="fa-solid fa-images" aria-hidden="true"></i> Arrange visuals
          <i
            class="fa-solid fa-arrow-right lib-studio-link-go"
            aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </header>

  <form class="bs-styleform" data-slug={slug} aria-label="Book citation style">
    <fieldset class="bs-chips">
      <legend>Style family</legend>
      {
        FAMILIES.map((f, i) => (
          <label class="bs-chip" data-template={f.id}>
            <input
              type="radio"
              name="citation-style"
              value={f.id}
              class="bs-radio"
              checked={i === 1}
            />
            <span class="bs-chip-head">
              <span class="bs-chip-name">{f.name}</span>
              <span class="bs-chip-check" aria-hidden="true">
                <i class="fa-solid fa-circle-check" />
              </span>
            </span>
            <span class="bs-chip-tag">{f.tagline}</span>
          </label>
        ))
      }
    </fieldset>

    {
      FAMILIES.map((f) => (
        <p class="bs-blurb" data-fam={f.id}>
          {f.blurb}
        </p>
      ))
    }

    <div class="bs-preview" aria-label="Style preview">
      <div class="bs-ct">
        <span class="bs-ct-label">Quran verse</span>
        <blockquote class="bs-verse">
          <p class="bs-ar" dir="rtl" lang="ar">
            إِنَّ أَفْضَلَ الْحَسَنَاتِ إِحْيَاءُ الْأَمْوَاتِ
          </p>
          <p class="bs-tr">
            &ldquo;The best of all good deeds is to bring the dead back to
            life.&rdquo;
          </p>
        </blockquote>
      </div>

      <div class="bs-ct">
        <span class="bs-ct-label">Hadith</span>
        <blockquote class="bs-hadith">
          <p class="bs-ar" dir="rtl" lang="ar">
            مَنْ عَمِلَ بِمَا عَلِمَ وَرَّثَهُ اللَّهُ عِلْمَ مَا لَمْ يَعْلَمْ
          </p>
          <p class="bs-tr">
            &ldquo;Whoever acts upon what he knows, God will bequeath to him the
            knowledge of what he does not know.&rdquo;
          </p>
          <p class="bs-attr">The Prophet Muhammad&nbsp;&#65018;</p>
        </blockquote>
      </div>

      <div class="bs-ct">
        <span class="bs-ct-label">Poetry</span>
        <div class="bs-poem">
          <p class="bs-ar" dir="rtl" lang="ar">
            وَمَنْ طَلَبَ الْعُلَا سَهِرَ اللَّيَالِي
          </p>
          <p class="bs-tr">
            Whoever seeks the heights stays wakeful through the nights.
          </p>
        </div>
      </div>

      <div class="bs-ct">
        <span class="bs-ct-label">Saying</span>
        <div class="bs-saying">
          <p>Thanks for knowledge is to act upon it.</p>
          <p class="bs-attr">A maxim of the learned</p>
        </div>
      </div>

      <div class="bs-ct">
        <span class="bs-ct-label">Quotation</span>
        <blockquote class="bs-quote">
          <p>
            The most important things a person can learn are almost never
            delivered as lectures. They arrive through a door someone opens by
            asking.
          </p>
        </blockquote>
      </div>

      <div class="bs-ct">
        <span class="bs-ct-label">Inline Arabic in prose</span>
        <p class="bs-inline">
          The Master frames gratitude as action —
          <span class="ar-inline" dir="rtl" lang="ar"
            >شُكْرُ الْعِلْمِ الْعَمَلُ بِهِ</span
          >
          — thanks for knowledge is to act upon it.
        </p>
      </div>
    </div>

    <p class="bs-save" id="bs-save" role="status" aria-live="polite"></p>
  </form>

  <p class="bs-foot">
    Your choice is saved for this book and used when you Generate the PDF.
    Passage types that aren&rsquo;t marked in the text yet — hadith, poetry,
    sayings — preview here so you can judge the family; they render in the book
    once each passage is tagged.
  </p>
  <script>
    import "../../../scripts/citation-style.ts";
  </script>
</Base>
