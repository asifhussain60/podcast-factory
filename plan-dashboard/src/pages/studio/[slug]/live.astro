---
/**
 * Studio — LIVE Session (a reading-with-someone view).
 *
 * /studio/<slug>/live — the whole composed book in a comfortable reading column
 * with a right-hand explanation panel that follows the scroll: as a section comes
 * into view, the panel shows that section's Companion notes (Asif's private
 * teaching notes, read-only here — never written to book.md or the PDF). A book
 * picker (bucket-filterable, multi-volume aware) switches between books.
 *
 * Read-only surface (studio-composer REQ-SC-010..015): it never writes book state.
 * Its own identity lives in live-session.css; the prose/citation styling is reused
 * from book-reader.css (the shared reader layer) rather than re-copied.
 */
import Base from '../../../layouts/Base.astro';
import { loadBook } from '../../../lib/reader/book';
import { loadLiveIndex } from '../../../lib/reader/live-index';
import { readChapter } from '../../../lib/reader/companion/store.server';
import { slugToTitle } from '../../../lib/content-paths';
import '../../../styles/library.css';
import '../../../styles/book-reader.css';
import '../../../styles/live-session.css';

const slug = Astro.params.slug!;
const book = await loadBook(slug);
const groups = await loadLiveIndex();
const bookTitle = book?.title ?? slugToTitle(slug);

// Per-section Companion notes (read-only). Keyed by the same heading-slug the
// reader stores notes under; guard so a non-standard key never breaks the page.
function notesFor(sectionId: string) {
  try {
    return readChapter(slug, sectionId).notes.map((n) => ({
      kind: n.kind,
      body: n.body,
      anchor: n.anchor ?? '',
      source: n.source?.label ?? n.source?.ref ?? '',
    }));
  } catch {
    return [];
  }
}
const sections = (book?.toc ?? []).map((t) => ({
  id: t.id,
  title: t.title,
  notes: notesFor(t.id),
}));
const totalNotes = sections.reduce((n, s) => n + s.notes.length, 0);
// Escape `<` so a note body containing "</script>" can't terminate the JSON
// data island early (defence-in-depth; the client parses via .textContent).
const explainJson = JSON.stringify({ slug, sections }).replace(/</g, '\\u003c');

const bucketsPresent = groups.map((g) => g.bucket);
---
<Base
  title={`LIVE Session — ${bookTitle}`}
  active="studio"
  description={`Studio · LIVE Session · ${bookTitle}`}
>
  {book ? (
    <div class="lsv" data-slug={slug}>
      <header class="lib-hero lsv-hero">
        <div class="lib-hero-main">
          <div class="lib-breadcrumb">
            <a href="/studio">Studio</a>
            <span class="lib-sep">›</span>
            <span>LIVE Session</span>
          </div>
          <div class="lib-title-row">
            <h1>{bookTitle}</h1>
          </div>
        </div>
        <div class="lib-hero-aside">
          <div class="lsv-picker" data-open="false">
            <button
              type="button"
              class="lsv-picker-trigger"
              id="lsv-picker-trigger"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="lsv-picker-panel"
            >
              <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
              <span class="lsv-picker-current">{bookTitle}</span>
              <i class="fa-solid fa-chevron-down lsv-picker-caret" aria-hidden="true"></i>
            </button>
            <div class="lsv-picker-panel" id="lsv-picker-panel" aria-label="Choose a book" hidden>
              <div class="lsv-filter" role="group" aria-label="Filter by collection">
                <button type="button" class="lsv-filter-chip is-active" data-bucket="all">All</button>
                {bucketsPresent.map((b) => (
                  <button type="button" class="lsv-filter-chip" data-bucket={b}>{b}</button>
                ))}
              </div>
              <div class="lsv-picker-list">
                {groups.map((g) => (
                  <section class="lsv-picker-group" data-bucket={g.bucket}>
                    <p class="lsv-picker-bucket">{g.bucket}</p>
                    <ul class="lsv-picker-books">
                      {g.entries.map((e) => (
                        e.multiVolume ? (
                          <li class="lsv-work">
                            <p class="lsv-work-title">{e.title}</p>
                            <ul class="lsv-vols">
                              {e.volumes.map((v) => (
                                <li>
                                  <a
                                    class={`lsv-book-link${v.slug === slug ? ' is-current' : ''}`}
                                    href={`/studio/${v.slug}/live`}
                                    aria-current={v.slug === slug ? 'true' : undefined}
                                  >{v.label}</a>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ) : (
                          <li>
                            <a
                              class={`lsv-book-link${e.volumes[0].slug === slug ? ' is-current' : ''}`}
                              href={`/studio/${e.volumes[0].slug}/live`}
                              aria-current={e.volumes[0].slug === slug ? 'true' : undefined}
                            >{e.title}</a>
                          </li>
                        )
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="lsv-stage">
        <article class="bookv-body lsv-read" set:html={book.html}></article>

        <aside class="lsv-explain" aria-label="Explanations" data-total={totalNotes}>
          <div class="lsv-explain-head">
            <p class="lsv-explain-eyebrow">Companion</p>
            <h2 class="lsv-explain-title" id="lsv-explain-title">Explanations</h2>
          </div>
          <div class="lsv-explain-body" id="lsv-explain-body" role="status" aria-live="polite">
            <p class="lsv-explain-empty">
              {totalNotes > 0
                ? 'Scroll the book — notes for the section you are reading appear here.'
                : 'No companion notes have been written for this book yet.'}
            </p>
          </div>
        </aside>
      </div>

      <script type="application/json" id="lsv-explain-data" is:inline set:html={explainJson}></script>
    </div>
  ) : (
    <div class="lsv-empty">
      <p>No reading edition has been generated for this book yet.</p>
      <p><a class="bookv-back" href={`/studio/${slug}/edit`}>← Back to Edit &amp; Enrich</a></p>
    </div>
  )}
  <script>import '../../../scripts/live-session.ts';</script>
</Base>
