---
/**
 * Studio — LIVE Session (a reading-with-someone view).
 *
 * /studio/<slug>/live — the composed book as one continuously-scrolling document:
 * every chapter is stacked as its own numbered sheet, the whole view governed by a
 * single (window) scrollbar. A Table of Contents jumps to any chapter, and a reading
 * toolbar (font / size / paper theme, mirroring the Book Composer editor) sits
 * centered above the page. A sticky right-hand explanation panel follows the scroll:
 * as a chapter comes into view the panel swaps to that chapter's Companion notes
 * (Asif's private teaching notes, read-only here — never written to book.md or the
 * PDF) and the chapter that owns those notes is highlighted, so the link between
 * panel and page is always visible. A note's quoted passage is marked in the text
 * when it appears verbatim. A book picker (bucket-filterable, multi-volume aware)
 * switches between books.
 *
 * Read-only surface (studio-composer REQ-SC-010..015). Its own identity lives in
 * live-session.css; prose/citation styling is reused from book-reader.css.
 */
import Base from "../../../layouts/Base.astro";
import { loadBook } from "../../../lib/reader/book";
import { loadLiveIndex } from "../../../lib/reader/live-index";
import { readChapter } from "../../../lib/reader/companion/store.server";
import { slugToTitle } from "../../../lib/content-paths";
import "../../../styles/library.css";
import "../../../styles/book-reader.css";
import "../../../styles/quote-typography.css";
import "../../../styles/editor-fonts.css";
import "../../../styles/live-session.css";
import "../../../styles/companion-card.css";

const slug = Astro.params.slug!;
const book = await loadBook(slug);
const groups = await loadLiveIndex();
const bookTitle = book?.title ?? slugToTitle(slug);

function notesFor(sectionId: string) {
  try {
    return readChapter(slug, sectionId).notes.map((n) => ({
      kind: n.kind,
      body: n.body,
      anchor: n.anchor ?? "",
      quote: n.quote ?? "",
      source: n.source?.label ?? n.source?.ref ?? "",
    }));
  } catch {
    return [];
  }
}
const sections = (book?.toc ?? []).map((t) => ({
  id: t.id,
  title: t.title,
  notes: notesFor(t.id),
}));
const totalNotes = sections.reduce((n, s) => n + s.notes.length, 0);
const explainJson = JSON.stringify({ slug, sections }).replace(/</g, "\\u003c");

// Reading toolbar options (mirror the Book Composer editor toolbar).
const FONTS = [
  { id: "serif", name: "Serif" },
  { id: "sans", name: "Sans" },
  { id: "lato", name: "Lato" },
  { id: "inter", name: "Inter" },
  { id: "mono", name: "Mono" },
  { id: "dyslexic", name: "Dyslexic" },
];
const PAPERS = [
  { id: "light", name: "Light", icon: "fa-sun" },
  { id: "sepia", name: "Sepia", icon: "fa-mug-hot" },
  { id: "dark", name: "Dark", icon: "fa-moon" },
];
const bucketsPresent = groups.map((g) => g.bucket);
---

<Base
  title={`LIVE Session — ${bookTitle}`}
  active="studio"
  description={`Studio · LIVE Session · ${bookTitle}`}
>
  {
    book ? (
      <div class="lsv" data-slug={slug} data-font="serif" data-paper="light">
        <div class="lsv-topbar">
          <div class="lsv-topbar-left">
            <div class="lsv-picker" data-open="false">
              <button
                type="button"
                class="lsv-picker-trigger"
                id="lsv-picker-trigger"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="lsv-picker-panel"
              >
                <i class="fa-solid fa-book-open-reader" aria-hidden="true" />
                <span class="lsv-picker-current">{bookTitle}</span>
                <i
                  class="fa-solid fa-chevron-down lsv-picker-caret"
                  aria-hidden="true"
                />
              </button>
              <div
                class="lsv-picker-panel"
                id="lsv-picker-panel"
                aria-label="Choose a book"
                hidden
              >
                <div
                  class="lsv-filter"
                  role="group"
                  aria-label="Filter by collection"
                >
                  <button
                    type="button"
                    class="lsv-filter-chip is-active"
                    data-bucket="all"
                  >
                    All
                  </button>
                  {bucketsPresent.map((b) => (
                    <button
                      type="button"
                      class="lsv-filter-chip"
                      data-bucket={b}
                    >
                      {b}
                    </button>
                  ))}
                </div>
                <div class="lsv-picker-list">
                  {groups.map((g) => (
                    <section class="lsv-picker-group" data-bucket={g.bucket}>
                      <p class="lsv-picker-bucket">{g.bucket}</p>
                      <ul class="lsv-picker-books">
                        {g.entries.map((e) =>
                          e.multiVolume ? (
                            <li class="lsv-work">
                              <p class="lsv-work-title">{e.title}</p>
                              <ul class="lsv-vols">
                                {e.volumes.map((v) => (
                                  <li>
                                    <a
                                      class={`lsv-book-link${v.slug === slug ? " is-current" : ""}`}
                                      href={`/studio/${v.slug}/live`}
                                      aria-current={
                                        v.slug === slug ? "true" : undefined
                                      }
                                    >
                                      {v.label}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </li>
                          ) : (
                            <li>
                              <a
                                class={`lsv-book-link${e.volumes[0].slug === slug ? " is-current" : ""}`}
                                href={`/studio/${e.volumes[0].slug}/live`}
                                aria-current={
                                  e.volumes[0].slug === slug
                                    ? "true"
                                    : undefined
                                }
                              >
                                {e.title}
                              </a>
                            </li>
                          ),
                        )}
                      </ul>
                    </section>
                  ))}
                </div>
              </div>
            </div>
            <button
              type="button"
              class="lsv-icon-btn lsv-toc-btn"
              id="lsv-toc-btn"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="lsv-toc"
            >
              <i class="fa-solid fa-list-ul" aria-hidden="true" />
              <span class="lsv-icon-btn-label">Contents</span>
            </button>
          </div>
        </div>

        <div class="lsv-controls" role="group" aria-label="Reading settings">
          <div class="lsv-tb-group">
            <label class="lsv-sr" for="lsv-font">
              Reading font
            </label>
            <select class="lsv-font-select" id="lsv-font" title="Reading font">
              {FONTS.map((f) => (
                <option value={f.id}>{f.name}</option>
              ))}
            </select>
            <div class="lsv-size" role="group" aria-label="Text size">
              <button
                type="button"
                class="lsv-size-btn"
                id="lsv-size-down"
                aria-label="Smaller text"
              >
                <i class="fa-solid fa-minus" aria-hidden="true" />
              </button>
              <span class="lsv-size-val" id="lsv-size-val" aria-live="polite">
                20
              </span>
              <button
                type="button"
                class="lsv-size-btn"
                id="lsv-size-up"
                aria-label="Larger text"
              >
                <i class="fa-solid fa-plus" aria-hidden="true" />
              </button>
            </div>
          </div>
          <div class="lsv-paper" role="group" aria-label="Paper theme">
            {PAPERS.map((p) => (
              <button
                type="button"
                class="lsv-paper-btn"
                data-paper={p.id}
                aria-pressed={p.id === "light" ? "true" : "false"}
                title={`${p.name} paper`}
                aria-label={`${p.name} paper`}
              >
                <i class={`fa-solid ${p.icon}`} aria-hidden="true" />
              </button>
            ))}
          </div>
        </div>

        <div class="lsv-reader">
          <div class="lsv-bookpane">
            <div class="lsv-viewport" id="lsv-viewport">
              <article
                class:list={[
                  "bookv-body",
                  "lsv-read",
                  book.citationFamily && `style-${book.citationFamily}`,
                  book.translationFont && `tr-${book.translationFont}`,
                ]}
                id="lsv-read"
                set:html={book.html}
              />
            </div>
          </div>

          <aside
            class="lsv-explain"
            aria-label="Explanations"
            data-total={totalNotes}
          >
            <div class="lsv-explain-head">
              <p class="lsv-explain-eyebrow">
                <i class="fa-solid fa-lightbulb" aria-hidden="true" /> Companion
              </p>
              <h2 class="lsv-explain-title" id="lsv-explain-title">
                Explanations
              </h2>
            </div>
            <div class="lsv-explain-body" id="lsv-explain-body">
              <p class="lsv-explain-empty">
                {totalNotes > 0
                  ? "Scroll the chapter — its companion notes appear here."
                  : "No companion notes have been written for this book yet."}
              </p>
            </div>
          </aside>
        </div>

        <div class="lsv-toc-scrim" id="lsv-toc-scrim" />
        <nav class="lsv-toc" id="lsv-toc" aria-label="Table of contents">
          <div class="lsv-toc-head">
            <p class="lsv-toc-title">
              <i class="fa-solid fa-list-ul" aria-hidden="true" /> Contents
            </p>
            <button
              type="button"
              class="lsv-icon-btn lsv-toc-close"
              id="lsv-toc-close"
              aria-label="Close contents"
            >
              <i class="fa-solid fa-xmark" aria-hidden="true" />
            </button>
          </div>
          <ol class="lsv-toc-list">
            {book.toc.map((t) => (
              <li>
                <button type="button" class="lsv-toc-link" data-target={t.id}>
                  {t.title}
                </button>
              </li>
            ))}
          </ol>
        </nav>

        <script
          type="application/json"
          id="lsv-explain-data"
          is:inline
          set:html={explainJson}
        />
      </div>
    ) : (
      <div class="lsv-empty">
        <p>No reading edition has been generated for this book yet.</p>
        <p>
          <a class="bookv-back" href={`/studio/${slug}/edit`}>
            ← Back to Edit &amp; Enrich
          </a>
        </p>
      </div>
    )
  }
  <script>
    import "../../../scripts/live-session.ts";
  </script>
</Base>
