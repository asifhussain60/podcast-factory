---
import Base from "../../../layouts/Base.astro";
import {
  loadDetail,
  formatBytes,
  formatModified,
  categoryLabel,
} from "../../../lib/library";
import { scoreBook, verdictLabel } from "../../../lib/peq-scores";
import EditableBookFacts from "../../../components/studio/EditableBookFacts";
import AudioPlayer from "../../../components/studio/AudioPlayer";
import HaltReview from "../../../components/studio/HaltReview";
import { buildStudioIndexView } from "../../../lib/reader/library-view";
import "../../../styles/library.css";

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/studio");
const detail = await loadDetail(slug);
if (!detail) return Astro.redirect("/studio");
const slugStr: string = slug;

const {
  summary,
  meta,
  chapters,
  episodes,
  slideDecks,
  audio,
  audits,
  sourceFiles,
  state,
} = detail;

const archetype = meta["archetype"] ?? null;
const bookScore = await scoreBook(summary.ref.dir, archetype);

// All derived view state lives in lib/reader/library-view.ts (R2 extraction);
// destructured under the template's long-standing names — template unchanged.
const {
  hasArabic,
  arabicReviewHref,
  fileViewHref,
  episodeGroups,
  hasSessions,
  humanizeFile,
  bookFacts,
  audioTracks,
  pipelineTone,
  activeHaltDef,
  haltArtifacts,
  haltSaved,
  haltHalted,
  mediaCount,
  tabs,
} = await buildStudioIndexView(detail, slugStr);
---

<Base
  title={summary.title}
  active="studio"
  description={`${categoryLabel(summary.category)} — ${summary.title}`}
>
  <header class="lib-hero">
    <div class="lib-hero-main">
      <div class="lib-breadcrumb">
        <a href="/studio">Studio</a>
        <span class="lib-sep">›</span>
        <span>{categoryLabel(summary.category)}</span>
      </div>
      <div class="lib-title-row">
        <h1>{summary.title}</h1>
        <span
          class={`lib-badge lib-badge-${summary.publicationStatus === "published" ? "published" : "drafts"}`}
          >{
            summary.publicationStatus === "published" ? "Published" : "Draft"
          }</span
        >
      </div>
      <div class="lib-hero-chips">
        {
          bookScore && (
            <span
              class={`lib-score-pill lib-score-${bookScore.avg >= 85 ? "pass" : bookScore.avg >= 70 ? "warn" : "fail"}`}
            >
              <i class="fa-solid fa-gauge-high" aria-hidden="true" />{" "}
              {bookScore.avg.toFixed(1)} avg —{" "}
              {verdictLabel(
                bookScore.avg >= 85
                  ? "PASS"
                  : bookScore.avg >= 70
                    ? "WARN"
                    : "FAIL",
              )}
            </span>
          )
        }
        {
          pipelineTone && (
            <span class={`lib-state-chip lib-state-${pipelineTone}`}>
              <i class="fa-solid fa-diagram-project" aria-hidden="true" />
              Phase {state.phase ?? "—"} · {state.phaseStatus ?? "—"}
            </span>
          )
        }
        {
          archetype && (
            <span class="lib-state-chip lib-state-neutral">
              <i class="fa-solid fa-masks-theater" aria-hidden="true" />
              {humanizeFile(archetype)}
            </span>
          )
        }
      </div>
    </div>
    <div class="lib-hero-aside">
      <div class="lib-title-actions">
        {
          hasArabic && (
            <a
              class="lib-studio-link lib-studio-link-arabic"
              href={arabicReviewHref}
            >
              <span aria-hidden="true" class="lib-arabic-glyph">
                ع
              </span>{" "}
              Review Arabic
              <i
                class="fa-solid fa-arrow-right lib-studio-link-go"
                aria-hidden="true"
              />
            </a>
          )
        }
      </div>
      <span class="lib-hero-slug">{summary.ref.slug}</span>
    </div>
  </header>

  <nav class="lib-tabs" aria-label="Book sections">
    {
      tabs.map((t, i) => (
        <Fragment>
          {t.id === "chapters" ? (
            /* Chapters navigates straight to the Book Composer (data-nav marks
             it so the in-page tab script does not intercept the click). The
             Composer is the consolidated authoring surface for the reading
             edition, so it is the single entry point here — the separate "PDF
             Generator" pill that pointed at the same route is gone rather than
             kept as a duplicate. Edit & Enrich (the podcast chapter/stage lane,
             a DIFFERENT set of files) is reachable from the Composer's own
             header. Styled as a pill because it leaves the page (REQ-SC-001). */
            <a href={`/studio/${slugStr}/compose`} class="lib-tab-cta" data-nav>
              <i class="fa-solid fa-list-ol" aria-hidden="true" /> {t.label}
              {t.count !== null && <span class="lib-tab-count">{t.count}</span>}
            </a>
          ) : (
            <a
              href={`#${t.id}`}
              class={`lib-tab${i === 0 ? " is-active" : ""}${t.count === 0 ? " is-empty" : ""}`}
              data-tab={t.id}
              aria-current={i === 0 ? "true" : undefined}
            >
              {t.label}
              {t.count !== null && <span class="lib-tab-count">{t.count}</span>}
            </a>
          )}
          {t.id === "media" && (
            <a class="lib-tab-cta" href={`/studio/${slugStr}/live`}>
              <i class="fa-solid fa-book-open-reader" aria-hidden="true" /> LIVE
              Session
            </a>
          )}
        </Fragment>
      ))
    }
  </nav>

  <section id="overview" class="lib-panel" data-panel="overview">
    {
      activeHaltDef && (
        <div class={`card halt-cockpit${haltHalted ? " is-halted" : ""}`}>
          <div class="halt-cockpit-head">
            <span class="halt-cockpit-eyebrow">
              <i class="fa-solid fa-circle-pause" aria-hidden="true" /> Review
              &amp; correct{haltHalted ? " · waiting on you" : ""}
            </span>
            <h2 class="halt-cockpit-title">{activeHaltDef.label}</h2>
            <p class="halt-cockpit-blurb">{activeHaltDef.blurb}</p>
          </div>
          <HaltReview
            client:load
            slug={slugStr}
            haltId={activeHaltDef.id}
            artifacts={haltArtifacts}
            saved={haltSaved}
          />
        </div>
      )
    }
    <div class="lib-overview-grid">
      <div class="card lib-facts-card">
        <h2 class="lib-panel-title">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i> About this book
        </h2>
        {
          summary.hasMeta ? (
            <EditableBookFacts client:load slug={slugStr} facts={bookFacts} />
          ) : (
            <p class="card-sub">
              No <code>meta.yml</code> on disk.
            </p>
          )
        }
      </div>
      <div class="lib-overview-side">
        {
          bookScore && (
            <div class="card lib-side-card">
              <h2 class="lib-panel-title">
                <i class="fa-solid fa-gauge-high" aria-hidden="true" /> Quality
              </h2>
              <div class="lib-peq-breakdown">
                {bookScore.passCount > 0 && (
                  <span class="lib-peq-stat lib-peq-pass">
                    {bookScore.passCount} excellent
                  </span>
                )}
                {bookScore.warnCount > 0 && (
                  <span class="lib-peq-stat lib-peq-warn">
                    {bookScore.warnCount} good
                  </span>
                )}
                {bookScore.failCount > 0 && (
                  <span class="lib-peq-stat lib-peq-fail">
                    {bookScore.failCount} needs work
                  </span>
                )}
              </div>
              <p class="card-sub">
                Per-chapter scores are on each binder card.
              </p>
            </div>
          )
        }
        {
          state.exists && (
            <div class="card lib-side-card">
              <h2 class="lib-panel-title">
                <i class="fa-solid fa-diagram-project" aria-hidden="true" />{" "}
                Pipeline
              </h2>
              <dl class="lib-facts lib-facts-tight">
                <div class="lib-fact">
                  <>
                    <dt>phase</dt>
                    <dd>{state.phase ?? "—"}</dd>
                  </>
                </div>
                <div class="lib-fact">
                  <>
                    <dt>status</dt>
                    <dd>{state.phaseStatus ?? "—"}</dd>
                  </>
                </div>
                <div class="lib-fact">
                  <>
                    <dt>last completed</dt>
                    <dd>{state.lastCompleted ?? "—"}</dd>
                  </>
                </div>
              </dl>
            </div>
          )
        }
        <div class="lib-danger-row">
          <div class="lib-danger-text">
            <strong>Archive this book</strong>
            <span class="card-sub"
              >Soft-deletes to <code>content/_archive/</code>. Reversible.</span
            >
          </div>
          <form
            method="POST"
            action={`/api/library/${summary.ref.slug}/archive`}
            data-confirm="Archive this piece of content?"
          >
            <button type="submit" class="lib-btn lib-btn-danger">Archive</button
            >
          </form>
        </div>
      </div>
    </div>
  </section>

  <section id="episodes" class="lib-panel" data-panel="episodes">
    <p class="lib-panel-sub">NotebookLM framings in <code>episodes/</code>.</p>
    {
      episodes.length === 0 ? (
        <div class="lib-empty-panel">
          <>
            <i class="fa-regular fa-folder-open" aria-hidden="true" />
            <p>No episodes yet — framings land here after chapter authoring.</p>
          </>
        </div>
      ) : (
        <div class={hasSessions ? "stack lib-session-stack" : ""}>
          {episodeGroups.map((g) => {
            const rows = (
              <div class="lib-asset-list">
                {g.files.map((f) => (
                  <a class="lib-asset-row" href={fileViewHref(f.relPath)}>
                    <span class="lib-asset-icon lib-asset-icon-doc">
                      <i class="fa-regular fa-file-lines" aria-hidden="true" />
                    </span>
                    <span class="lib-asset-name">{humanizeFile(f.name)}</span>
                    <span class="lib-asset-meta">
                      {formatBytes(f.bytes)} · {formatModified(f.modified)}
                    </span>
                  </a>
                ))}
              </div>
            );
            return g.label ? (
              <details class="lib-session-group" open>
                <summary class="lib-session-summary">
                  <span class="lib-session-name">{g.label}</span>
                  <span class="lib-session-count">
                    {g.count} episode{g.count === 1 ? "" : "s"}
                  </span>
                </summary>
                {rows}
              </details>
            ) : (
              rows
            );
          })}
        </div>
      )
    }
  </section>

  <section id="media" class="lib-panel" data-panel="media">
    <h2 class="lib-panel-title">
      <i class="fa-solid fa-headphones" aria-hidden="true"></i> Audio · {
        audio.length
      }
    </h2>
    <p class="lib-panel-sub">
      NotebookLM Audio Overview downloads in <code>m4a/</code>. Audio is
      gitignored.
    </p>
    {
      audio.length === 0 ? (
        <div class="lib-empty-panel">
          <>
            <i class="fa-regular fa-folder-open" aria-hidden="true" />
            <p>No audio files yet.</p>
          </>
        </div>
      ) : (
        <AudioPlayer client:load tracks={audioTracks} />
      )
    }
    <h2 class="lib-panel-title lib-panel-title-gap">
      <i class="fa-solid fa-images" aria-hidden="true"></i> Slide decks · {
        slideDecks.length
      }
    </h2>
    <p class="lib-panel-sub">
      One folder per chapter under <code>_system/slide-decks/</code>.
    </p>
    {
      slideDecks.length === 0 ? (
        <div class="lib-empty-panel">
          <>
            <i class="fa-regular fa-folder-open" aria-hidden="true" />
            <p>No slide decks yet.</p>
          </>
        </div>
      ) : (
        <div class="lib-deck-grid">
          {slideDecks.map((deck) => (
            <div class="card card-tight stack">
              <h3 class="card-title lib-deck-title">{deck.slug}</h3>
              <div class="lib-deck-files">
                {deck.files.map((f) => (
                  <a class="lib-mini-link" href={fileViewHref(f.relPath)}>
                    {f.name}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section id="audits" class="lib-panel" data-panel="audits">
    <p class="lib-panel-sub">Challenger reports + postprod-review findings.</p>
    {
      audits.length === 0 ? (
        <div class="lib-empty-panel">
          <>
            <i class="fa-regular fa-folder-open" aria-hidden="true" />
            <p>No audits yet.</p>
          </>
        </div>
      ) : (
        <div class="lib-asset-list">
          {audits.map((f) => (
            <a
              class="lib-asset-row"
              href={fileViewHref(f.relPath)}
              target="_blank"
            >
              <span class="lib-asset-icon lib-asset-icon-audit">
                <i class="fa-solid fa-clipboard-check" aria-hidden="true" />
              </span>
              <span class="lib-asset-name">{humanizeFile(f.name)}</span>
              <span class="lib-asset-meta">
                {formatBytes(f.bytes)} · {formatModified(f.modified)}
              </span>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section id="source" class="lib-panel" data-panel="source">
    <p class="lib-panel-sub">
      Refined English, phonetics, raw extract, source-toc — under <code
        >_system/source/text/</code
      >.
    </p>
    {
      sourceFiles.length === 0 ? (
        <div class="lib-empty-panel">
          <>
            <i class="fa-regular fa-folder-open" aria-hidden="true" />
            <p>No source files yet.</p>
          </>
        </div>
      ) : (
        <div class="lib-asset-list">
          {sourceFiles.map((f) => (
            <a
              class="lib-asset-row"
              href={fileViewHref(f.relPath)}
              target="_blank"
            >
              <span class="lib-asset-icon lib-asset-icon-doc">
                <i class="fa-regular fa-file-lines" aria-hidden="true" />
              </span>
              <span class="lib-asset-name">{humanizeFile(f.name)}</span>
              <span class="lib-asset-meta">
                {formatBytes(f.bytes)} · {formatModified(f.modified)}
              </span>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Base>

<script>
  // Hash-routed tab switching. Panels render server-side (visible without JS);
  // on load we collapse to the active tab. Legacy anchors map to their new tab.
  const LEGACY: Record<string, string> = {
    meta: "overview",
    audio: "media",
    "slide-decks": "media",
  };
  const tabLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".lib-tab"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>(".lib-panel"),
  );
  const ids = new Set(panels.map((p) => p.dataset.panel ?? ""));

  function activate(rawId: string, push: boolean): void {
    const id = ids.has(rawId) ? rawId : (LEGACY[rawId] ?? "overview");
    for (const p of panels) p.hidden = p.dataset.panel !== id;
    for (const t of tabLinks) {
      const on = t.dataset.tab === id;
      t.classList.toggle("is-active", on);
      if (on) t.setAttribute("aria-current", "true");
      else t.removeAttribute("aria-current");
    }
    if (push) history.replaceState(null, "", `#${id}`);
  }

  activate(window.location.hash.replace(/^#/, "") || "overview", false);
  for (const t of tabLinks) {
    if (t.hasAttribute("data-nav")) continue; // real navigation links (Chapters -> editor) aren't hijacked
    t.addEventListener("click", (e) => {
      e.preventDefault();
      activate(t.dataset.tab ?? "overview", true);
      window.scrollTo({ top: 0 });
    });
  }
  window.addEventListener("hashchange", () => {
    activate(window.location.hash.replace(/^#/, "") || "overview", false);
  });

  // Destructive-action confirm (replaces the former inline onclick attribute).
  for (const form of document.querySelectorAll<HTMLFormElement>(
    "form[data-confirm]",
  )) {
    form.addEventListener("submit", (e) => {
      if (!window.confirm(form.dataset.confirm ?? "Are you sure?"))
        e.preventDefault();
    });
  }
</script>
