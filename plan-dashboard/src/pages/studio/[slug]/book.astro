---
/**
 * Studio — /studio/<slug>/book redirect.
 *
 * The Reading edition page that used to live here (a floating Companion
 * notes panel over a read-only book view) was folded into the Book
 * Composer's Companion tab (2026-07-19) — editing a chapter and its
 * companion notes now happens in one place instead of two. This route stays
 * only so old links/bookmarks land somewhere real.
 */
const slug = Astro.params.slug!;
return Astro.redirect(`/studio/${slug}/compose`);
---
