---
/**
 * /snag-list — The Snag List: the repo's general issue/work-request backlog.
 *
 * Reads _workspace/plan/pending-work.yaml LIVE on every request (server-rendered,
 * not a build-time snapshot) so it always reflects what's actually in the file —
 * the same file the per-book status card prints from (_pending_work.py). No JS:
 * every item is its own native <details> accordion panel — collapsed shows a
 * plain-English headline, expanded shows the full record as bullets.
 *
 * Type sizes on this page intentionally sit below the site's REQ-010 reading
 * floor (1.2rem) — Asif's explicit 2026-08-08 direction to bring a dense
 * work-list closer to ordinary UI/dashboard scale (13–16px) rather than the
 * editorial reading floor built for prose pages. Scoped to this page only.
 */
import Base from "../layouts/Base.astro";
import AudienceBadge from "../components/AudienceBadge.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import yaml from "js-yaml";
import "../styles/snag-list.css";

interface SnagItem {
  id: string;
  scope: string;
  status: "doing" | "open" | "done";
  priority?: "P0" | "P1" | "P2";
  effort?: "S" | "M" | "L";
  order?: number;
  summary?: string;
  title: string;
  noticed?: string;
}

/** A short, plain-English accordion header — the item's own `summary` field
 *  when present, else the first clause of `title` (many titles open with a
 *  loud prefix like "RESOLVED:"/"HAZARD," which reads fine as a fallback
 *  headline on its own). */
function headline(item: SnagItem): string {
  if (item.summary) return item.summary;
  const first = item.title.split(/(?<=[.?!])\s+| -- /)[0];
  return first.length > 90 ? first.slice(0, 87) + "…" : first;
}

/** The full record, broken into bullet-sized fragments for the expanded
 *  panel. These titles are hand-written prose, not a bullet list, so this is
 *  a display transform, not a schema — split first on " -- ", the dominant
 *  clause separator this prose already uses, then further split any
 *  still-long fragment on sentence boundaries. */
function splitIntoBullets(text: string): string[] {
  const clauses = text.split(/\s+--\s+/);
  const bullets: string[] = [];
  for (const clause of clauses) {
    if (clause.length <= 220) {
      bullets.push(clause.trim());
      continue;
    }
    const sentences = clause.split(/(?<=[.?!])\s+(?=[A-Z(0-9])/);
    bullets.push(...sentences.map((s) => s.trim()));
  }
  return bullets.filter(Boolean);
}

function loadItems(): SnagItem[] {
  const path = resolve(process.cwd(), "../_workspace/plan/pending-work.yaml");
  try {
    const doc = yaml.load(readFileSync(path, "utf-8")) as {
      items?: Array<Omit<SnagItem, "noticed"> & { noticed?: string | Date }>;
    };
    const items = Array.isArray(doc?.items) ? doc.items : [];
    // js-yaml parses an unquoted `noticed: 2026-07-18` scalar into a native Date
    // (YAML 1.1 timestamp type), not a string -- left alone, `{item.noticed}`
    // renders its full toString() ("Sat Jul 18 2026 20:00:00 GMT-0400 ...").
    // Normalize back to plain YYYY-MM-DD here, once, rather than at every call site.
    return items.map((i) => ({
      ...i,
      noticed:
        i.noticed instanceof Date
          ? i.noticed.toISOString().slice(0, 10)
          : i.noticed,
    }));
  } catch {
    return [];
  }
}

const items = loadItems();
const openStatuses = new Set(["doing", "open"]);
const openItems = items.filter((i) => openStatuses.has(i.status));
const doneItems = items.filter((i) => i.status === "done");
const doingCount = items.filter((i) => i.status === "doing").length;
const p0OpenCount = openItems.filter((i) => i.priority === "P0").length;

// Group by scope, open items first within each group, `doing` before `open`.
const statusRank: Record<string, number> = { doing: 0, open: 1, done: 2 };
const priorityRank: Record<string, number> = { P0: 0, P1: 1, P2: 2 };
const scopes = Array.from(new Set(items.map((i) => i.scope))).sort((a, b) => {
  // pipeline and general first (repo-wide), then book slugs alphabetically.
  const rank = (s: string) => (s === "pipeline" ? 0 : s === "general" ? 1 : 2);
  return rank(a) - rank(b) || a.localeCompare(b);
});

// Open items: what's happening now first, then most urgent, then any manual
// tie-breaker, then most recently noticed — so the top of the table is
// always the thing most worth reading next.
function openSort(a: SnagItem, b: SnagItem): number {
  const byStatus = statusRank[a.status] - statusRank[b.status];
  if (byStatus !== 0) return byStatus;
  const byPriority =
    priorityRank[a.priority ?? "P1"] - priorityRank[b.priority ?? "P1"];
  if (byPriority !== 0) return byPriority;
  const aOrder = a.order ?? Number.MAX_SAFE_INTEGER;
  const bOrder = b.order ?? Number.MAX_SAFE_INTEGER;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return (b.noticed ?? "").localeCompare(a.noticed ?? "");
}

// Done items: most recently closed first.
function doneSort(a: SnagItem, b: SnagItem): number {
  return (b.noticed ?? "").localeCompare(a.noticed ?? "");
}

function itemsForScope(scope: string, status: "open" | "done"): SnagItem[] {
  const pool = status === "open" ? openItems : doneItems;
  const filtered = pool.filter((i) => i.scope === scope);
  return status === "open" ? filtered.sort(openSort) : filtered.sort(doneSort);
}

function scopeLabel(scope: string): string {
  if (scope === "pipeline") return "Pipeline — the machinery itself";
  if (scope === "general")
    return "General — repo-wide, not book- or pipeline-specific";
  return scope;
}
---

<Base title="The Snag List" active="snag-list">
  <section class="snag-hero">
    <header class="stack">
      <span class="eyebrow">The Snag List</span>
      <p class="home-hero-audience"><AudienceBadge tier="you" /></p>
      <h1>What's still open, and what's already closed.</h1>
      <p class="lede">
        The factory-floor term for the punch list before a build ships — the
        same backlog every book's status card reads from (<code
          >_workspace/plan/pending-work.yaml</code
        >), shown here in full. Each item is one line — click it to expand the
        full detail. Priority (P0 urgent, P1 normal, P2 someday) sorts the most
        urgent work to the top of every group; finished work stays visible, just
        collapsed out of the way.
      </p>
    </header>

    <div class="snag-stat-strip">
      <div class="snag-stat-card snag-stat-open">
        <div class="snag-stat-value">{openItems.length}</div>
        <div class="snag-stat-label">Open</div>
      </div>
      <div class="snag-stat-card snag-stat-doing">
        <div class="snag-stat-value">{doingCount}</div>
        <div class="snag-stat-label">In progress</div>
      </div>
      <div class="snag-stat-card snag-stat-p0">
        <div class="snag-stat-value">{p0OpenCount}</div>
        <div class="snag-stat-label">Urgent (P0)</div>
      </div>
      <div class="snag-stat-card snag-stat-done">
        <div class="snag-stat-value">{doneItems.length}</div>
        <div class="snag-stat-label">Done</div>
      </div>
    </div>
  </section>

  <main class="snag-body">
    {
      items.length === 0 && (
        <section id="s01-empty" class="snag-section">
          <h2>
            <span class="snag-num">01</span> The list couldn't be read
          </h2>
          <p>
            Either <code>pending-work.yaml</code> is empty or the file couldn't
            be parsed. Check <code>_workspace/plan/pending-work.yaml</code>{" "}
            directly.
          </p>
        </section>
      )
    }

    {
      scopes.map((scope, idx) => {
        const open = itemsForScope(scope, "open");
        const done = itemsForScope(scope, "done");
        if (open.length === 0 && done.length === 0) return null;
        const num = String(idx + 1).padStart(2, "0");
        return (
          <section id={`s${num}-${scope}`} class="snag-section">
            <h2>
              <span class="snag-num">{num}</span> {scopeLabel(scope)}
            </h2>

            {open.length > 0 ? (
              <div class="snag-items">
                {open.map((item) => (
                  <details class="snag-item">
                    <summary class="snag-item-summary">
                      <span class={`snag-badge snag-badge-${item.status}`}>
                        {item.status}
                      </span>
                      {item.priority ? (
                        <span
                          class={`snag-priority snag-priority-${item.priority}`}
                        >
                          {item.priority}
                        </span>
                      ) : (
                        <span class="snag-unset">—</span>
                      )}
                      {item.effort ? (
                        <span class="snag-effort">{item.effort}</span>
                      ) : (
                        <span class="snag-unset">—</span>
                      )}
                      <span class="snag-item-headline">{headline(item)}</span>
                      <span class="snag-noticed">{item.noticed ?? "—"}</span>
                    </summary>
                    <div class="snag-item-body">
                      <p class="snag-item-id">{item.id}</p>
                      <ul>
                        {splitIntoBullets(item.title).map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    </div>
                  </details>
                ))}
              </div>
            ) : (
              <p class="snag-empty">Nothing open here.</p>
            )}

            {done.length > 0 && (
              <details class="snag-done-details">
                <summary>
                  {done.length} closed item{done.length === 1 ? "" : "s"} in
                  this scope
                </summary>
                <div class="snag-items">
                  {done.map((item) => (
                    <details class="snag-item snag-item-done">
                      <summary class="snag-item-summary">
                        <span class="snag-done-check" aria-hidden="true">
                          ✓
                        </span>
                        <span class="snag-item-headline">{headline(item)}</span>
                        <span class="snag-noticed">{item.noticed ?? "—"}</span>
                      </summary>
                      <div class="snag-item-body">
                        <p class="snag-item-id">{item.id}</p>
                        <ul>
                          {splitIntoBullets(item.title).map((bullet) => (
                            <li>{bullet}</li>
                          ))}
                        </ul>
                      </div>
                    </details>
                  ))}
                </div>
              </details>
            )}
          </section>
        );
      })
    }
  </main>
</Base>
