---
/**
 * StudioSubnav.astro — the Studio domain's secondary navigation.
 *
 * Two parts, replacing the generic site subnav for the Studio pipeline:
 *   1. A persistent BOOK SELECTOR (pure HTML <details>, no JS) — pick the book
 *      once; every step inherits it via the URL.
 *   2. The sequential STEPPER — Intake → Source Review → Edit & Enrich → Publish
 *      with live status icons from the pipeline state.
 */
import type { StudioStep, StepId } from '../../lib/reader/studio-pipeline';

interface BookOption { slug: string; title: string }

interface Props {
  slug: string;
  bookTitle: string;
  activeStep: StepId;
  steps: StudioStep[];
  books: BookOption[];
}

const { slug, bookTitle, activeStep, steps, books } = Astro.props;

const STATE_ICON: Record<string, string> = {
  done: 'fa-circle-check',
  active: 'fa-circle-dot',
  pending: 'fa-circle',
  blocked: 'fa-circle-exclamation',
};
---
<nav class="studio-subnav" aria-label="Studio pipeline">
  <div class="studio-subnav-inner">
    <details class="studio-bookpick">
      <summary>
        <span class="studio-bookpick-eyebrow">Book</span>
        <span class="studio-bookpick-current">{bookTitle}</span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
      </summary>
      <div class="studio-bookpick-menu">
        {books.map((b) => (
          <a
            href={`/studio/${b.slug}/${activeStep}`}
            class={`studio-bookpick-item${b.slug === slug ? ' is-current' : ''}`}
            aria-current={b.slug === slug ? 'page' : undefined}
          >{b.title}</a>
        ))}
        <a href="/studio/new" class="studio-bookpick-item studio-bookpick-new">
          <i class="fa-solid fa-plus" aria-hidden="true"></i> New content
        </a>
      </div>
    </details>

    <ol class="studio-stepper">
      {steps.map((step, i) => (
        <li class={`studio-step state-${step.state}${step.id === activeStep ? ' is-active' : ''}`}>
          <a href={`/studio/${slug}/${step.id}`} class="studio-step-link" aria-current={step.id === activeStep ? 'step' : undefined}>
            <span class="studio-step-icon"><i class={`fa-solid ${STATE_ICON[step.state]}`} aria-hidden="true"></i></span>
            <span class="studio-step-copy">
              <span class="studio-step-num">Step {i + 1}</span>
              <span class="studio-step-label">{step.label}</span>
              <span class="studio-step-detail">{step.detail}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>
