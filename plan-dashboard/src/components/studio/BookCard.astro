---
/**
 * BookCard.astro — the ONE Studio card template.
 *
 * Both shelf branches render this: a standalone book (wrapped in an `<a>`) and a
 * multi-volume series deck (wrapped in a `<summary>`). They used to be two
 * near-identical copies inlined in studio.astro, and they had already drifted
 * five slots apart — the deck had no uncatalogued pill, no blurb, no generation
 * pills, no count, and no pipeline status at all. That is why the shelf looked
 * non-deterministic: not one design rendered from varying data, but two designs.
 *
 * EVERY SLOT ALWAYS RENDERS. The old markup wrapped each one in `&&`, so a book
 * with no author simply had no author line and its neighbours in the same row
 * stretched around the gap. Absent data now prints an em dash and keeps its
 * space, and the two identity panels carry a `min-height` so the divider between
 * the script panel and the body sits at the same height on every card.
 *
 * This component renders the card's INSIDE only. The wrapper is the caller's,
 * because `<details>` requires its clickable child to be a `<summary>` and a
 * standalone book must be an `<a>` — one element cannot be both.
 */
import type {
  BookCardIdentity,
  StudyTrack,
} from "../../lib/reader/book-card-identity";
import type {
  ArticulationStage,
  ArticulationStatus,
} from "../../lib/reader/studio-pipeline";

/** Sentence case, matching the Library's own labels for the same five. */
const TRACK_LABELS: Record<StudyTrack, string> = {
  theology: "Theology",
  history: "History",
  shariah: "Shariah",
  esoteric: "Esoteric",
  reality: "Reality",
};

/** One icon + label pair per ArticulationStage — the band's only two moving
 *  parts besides its colour, which comes from CSS via `data-stage`. */
const ARTICULATION_ICON: Record<ArticulationStage, string> = {
  none: "fa-regular fa-clock",
  progress: "fa-solid fa-pen-nib",
  articulated: "fa-solid fa-calendar-check",
  published: "fa-solid fa-star",
};

function formatArticulationDate(iso: string | null): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function articulationLabel(status: ArticulationStatus): string {
  const date = formatArticulationDate(status.at);
  switch (status.stage) {
    case "none":
      return "Not yet articulated";
    case "progress":
      return "Articulating chapters";
    case "articulated":
      return date ? `Articulated ${date}` : "Articulated";
    case "published":
      return date ? `Published ${date}` : "Published";
  }
}

interface PipelineStep {
  state: string;
}

export interface Props {
  identity: BookCardIdentity;
  /** PDF / podcast / augmented indicators. A deck passes all false. */
  pdfGenerated?: boolean;
  podcastGenerated?: boolean;
  podcastPlanned?: boolean;
  augmented?: boolean;
  /** "6 episodes" for a book, "6 volumes" for a deck. */
  countLabel?: string;
  /** The pipeline line. A deck passes its aggregate. */
  statusLabel: string;
  steps?: PipelineStep[];
  /** How far the prose itself has gone — a deck passes its laggard volume's. */
  articulation?: ArticulationStatus;
  /** Renders the deck's disclosure chevron inside the count slot. */
  chevron?: boolean;
}

const {
  identity,
  pdfGenerated = false,
  podcastGenerated = false,
  podcastPlanned = true,
  augmented = false,
  countLabel = "",
  statusLabel,
  steps = [],
  articulation = { stage: "none", at: null },
  chevron = false,
} = Astro.props;

const PILLS = [
  {
    on: pdfGenerated,
    icon: "fa-file-pdf",
    yes: "PDF generated",
    no: "PDF not yet generated",
  },
  {
    on: podcastGenerated,
    icon: "fa-headphones",
    yes: "Podcast generated",
    no: podcastPlanned ? "Podcast not yet generated" : "No podcast planned",
  },
  {
    on: augmented,
    icon: "fa-sparkles",
    yes: "Augmented from the corpus",
    no: "Not yet augmented",
  },
];
---

{
  /* ── Script panel — the icon always, the native title when the book has one ── */
}
<div class={`card-script-wrap${identity.nativeTitle ? " has-script" : ""}`}>
  {
    /* The study-track ribbon, in the same corner and the same colours the
       Podcast Factory Library uses — the values are synced from one file, so
       Esoteric is the same amber on both. Rendered only when the book names a
       track: a missing ribbon says "not classified", which is true, where a
       default one would say something no file does. */
    identity.studyTrack && (
      <span class="card-track-ribbon" data-track={identity.studyTrack}>
        {TRACK_LABELS[identity.studyTrack]}
      </span>
    )
  }
  <span class="card-script-icon" aria-hidden="true">
    <i class={`fa-solid ${identity.icon}`}></i>
  </span>
  {
    identity.nativeTitle && (
      <span
        class="card-script-text"
        lang={identity.nativeLang ?? "ar"}
        dir={
          identity.nativeLang === "ar" || identity.nativeLang === "ur"
            ? "rtl"
            : undefined
        }
      >
        {identity.nativeTitle}
      </span>
    )
  }
</div>

{
  /* Full-width, coloured by how far authoring has gone — see
     ArticulationStage. Same shape at every stage so a card's height never
     depends on its stage, only the swatch and its icon/text do. */
}
<div class="card-articulation-band" data-stage={articulation.stage}>
  <i class={ARTICULATION_ICON[articulation.stage]} aria-hidden="true"></i>
  <span>{articulationLabel(articulation)}</span>
</div>

{/* ── Body: identity, indicators, pipeline ── */}
<div class="card-body-wrap">
  <div class="card-identity">
    <h3 class="card-title-en">{identity.title}</h3>
    {
      identity.volume && (
        <span class="card-volume-badge">Volume {identity.volume}</span>
      )
    }
    {
      /* Held rather than omitted: an absent author used to remove the line and
        let the card above it collapse to a different height. */
    }
    <span class={`card-author${identity.author ? "" : " is-empty"}`}>
      {identity.author ?? "—"}
    </span>
    {
      identity.uncatalogued && (
        <span class="card-uncatalogued-pill">Not yet catalogued</span>
      )
    }
  </div>

  {identity.blurb && <p class="card-blurb">{identity.blurb}</p>}

  <div class="card-gen-pills">
    {
      PILLS.map((p) => (
        <span
          class={`card-gen-pill${p.on ? " is-generated" : ""}`}
          title={p.on ? p.yes : p.no}
          aria-label={p.on ? p.yes : p.no}
        >
          <i class={`fa-solid ${p.icon}`} aria-hidden="true" />
        </span>
      ))
    }
    {
      countLabel && (
        <span class="card-episode-count">
          {countLabel}
          {chevron && (
            <i
              class="fa-solid fa-chevron-down studio-series-chevron"
              aria-hidden="true"
            />
          )}
        </span>
      )
    }
  </div>

  <div class="card-pipeline-status">
    <span class="studio-picker-step">{statusLabel}</span>
    <div class="studio-picker-bar" aria-hidden="true">
      {
        steps.map((s) => (
          <span
            class={`studio-picker-seg${s.state === "done" ? " is-done" : s.state === "active" ? " is-active" : s.state === "blocked" ? " is-blocked" : ""}`}
          />
        ))
      }
    </div>
  </div>
</div>
