{
  "name": "plan-dashboard",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Living planning surface for podcast-factory. Three views (Architecture, Infrastructure, Live Execution Dashboard) regenerated by the podcast-planner agent. See README.md.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --import ./scripts/lib/ts-resolve-hook.mjs --test \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "snapshot": "node scripts/regenerate-snapshots.mjs || python3 scripts/regenerate-snapshots.py",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "mermaid:render": "node scripts/render-mermaid.mjs",
    "prebuild": "npm run mermaid:render && npm run lint:views",
    "lint:views": "node scripts/lint-html-views.mjs",
    "lint:views:strict": "node scripts/lint-html-views.mjs --strict",
    "smoke": "node scripts/site-health-smoke.mjs",
    "smoke:json": "node scripts/site-health-smoke.mjs --json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@astrojs/check": "^0.9.2",
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.19",
    "@google/generative-ai": "^0.24.1",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.100.14",
    "@tiptap/core": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "astro": "^7.0.0",
    "better-sqlite3": "^12.10.0",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "gsap": "^3.15.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "mermaid": "^11.15.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.0"
  }
}
