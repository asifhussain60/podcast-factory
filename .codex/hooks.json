{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/plan-snapshot-regen.sh",
            "statusMessage": "Plan-snapshot regen"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/site-work-status.sh",
            "statusMessage": "Site-work continuity"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cortex-view-guard.sh",
            "statusMessage": "Cortex HTML-view guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ui-reviewer-stop.sh"
          }
        ]
      }
    ]
  }
}
