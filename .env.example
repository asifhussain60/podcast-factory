# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Required by scripts/gemini_chat.py
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: default system instruction (persona / Gem prompt).
# Can also be passed per-run with --system FILE_OR_TEXT.
# GEMINI_SYSTEM_INSTRUCTION=

# Optional: override the default model (gemini-2.5-flash).
# Note: gemini-2.0-flash (unversioned) is retired; use gemini-2.0-flash-001 if needed.
# GEMINI_MODEL=gemini-2.5-flash
