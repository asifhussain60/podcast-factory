{"body": {"ayah": 253, "surah": 2, "text_en": "Those are the messengers; We preferred some of them over others."}, "confidence": 1.0, "content_level": null, "first_seen": {"book": "ansaar-bhai-augment", "chapter": "lec03", "date": "2026-06-15"}, "id": "quran:2:253", "sources": [{"book": "ansaar-bhai-augment", "chapter": "lec03", "locator": null}], "tradition": "universal", "type": "quran", "variants": []}
{"body": {"ayah": 255, "surah": 2, "text_en": "La ikraha fi al-din (There is no compulsion in religion)."}, "confidence": 1.0, "content_level": null, "first_seen": {"book": "ibrahim-2015-augment", "chapter": "lec06", "date": "2026-06-15"}, "id": "quran:2:255", "sources": [{"book": "ibrahim-2015-augment", "chapter": "lec06", "locator": null}], "tradition": "universal", "type": "quran", "variants": [{"book": "ibrahim-2015-augment", "text_en": "qad tabayyana al-rushdu min al-ghayy (the right course has become distinct from the wrong).", "translator": null}]}
{"body": {"ayah": 281, "surah": 2, "text_en": "And fear a Day when you will be returned to Allah. Then every soul will be paid in full what it has earned, and they will not be wronged."}, "confidence": 1.0, "content_level": null, "first_seen": {"book": "ibrahim-2015-augment", "chapter": "lec09", "date": "2026-06-15"}, "id": "quran:2:281", "sources": [{"book": "ibrahim-2015-augment", "chapter": "lec09", "locator": null}], "tradition": "universal", "type": "quran", "variants": []}
{"body": {"ayah": 282, "surah": 2, "text_en": "O you who have believed, when you contract a debt for a specified term, write it down."}, "confidence": 1.0, "content_level": null, "first_seen": {"book": "ibrahim-2015-augment", "chapter": "lec09", "date": "2026-06-15"}, "id": "quran:2:282", "sources": [{"book": "ibrahim-2015-augment", "chapter": "lec09", "locator": null}], "tradition": "universal", "type": "quran", "variants": []}
