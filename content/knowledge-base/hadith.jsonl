{"body": {"collection": "other", "grade": "unknown", "narrator": null, "number": 262, "text_en": "Truth is not recognized by men; rather, recognize the truth and you will recognize its people"}, "confidence": 1.0, "content_level": null, "first_seen": {"book": "the-master-and-the-disciple", "chapter": "ch16e-jewels-moon-and-the-description-of-religion", "date": "2026-06-14"}, "id": "hadith:other:e85825fa20f5", "sources": [{"book": "the-master-and-the-disciple", "chapter": "ch16e-jewels-moon-and-the-description-of-religion", "locator": null}], "tradition": "universal", "type": "hadith", "variants": []}
