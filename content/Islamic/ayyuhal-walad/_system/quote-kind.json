{
  "schema": "book.quote-kind/v1",
  "chapters": {
    "knowledge that will not save you": {
      "اَللَّهُمَّ أَعُوذُ بِكَ مِنْ عِلْمٍ لَا يَنْفَعُ": "hadith",
      "مَنْ جَاوَزَ الْأَرْبَعِينَ وَلَمْ يَغْلِبْ خَيْرُهُ عَلَىٰ شَرِّهِ فَلْيَتَجَهَّزْ إِلَىٰ النَّارِ": "hadith",
      "أَشَدُّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ عَالِمٌ لَا يَنْفَعُهُ اللَّهُ بِعِلْمِهِ": "hadith",
      "كَرَمِي دُو هَزَارْ رَطْلْ هَمِي بِيْمَائِي * تَا مَيْ نَخُورِي نَبَاشَدَتْ شَيْدَائِي": "poem"
    },
    "the striving that mercy meets": {
      "حَاسِبُوا أَنْفُسَكُمْ قَبْلَ أَنْ تُحَاسَبُوا، وَ زِنُوا أَعْمَالَكُمْ قَبْلَ أَنْ تُوزَنُوا": "hadith",
      "طَلَبُ الْجَنَّةِ بِلَا عَمَلٍ ذَنْبٌ مِنَ الذُّنُوبِ": "quote",
      "عَلَامَةُ الْحَقِيقَةِ تَرْكُ مُلَاحَظَةِ الْعَمَلِ لَا تَرْكُ الْعَمَلِ": "quote",
      "سَهَرُ الْعُيُونِ لِغَيْرِ وَجْهِكَ ضَائِعٌ * وَ بُكَاؤُهُنَّ لِغَيْرِ فَقْدِكَ بَاطِلٌ": "poem",
      "عِشْ مَا شِئْتَ فَإِنَّكَ مَيِّتٌ، وَ أَحْبِبْ مَا شِئْتَ فَإِنَّكَ مُفَارِقُهُ؛ وَ اِعْمَلْ مَا شِئْتَ فَإِنَّكَ مَجْزِيٌّ بِهِ": "hadith"
    },
    "the hours before dawn": {
      "ثَلَاثَةُ أَصْوَاتٍ يُحِبُّهَا اللَّهُ تَعَالَى: صَوْتُ الدِّيكِ، وَصَوْتُ الَّذِي يَقْرَأُ الْقُرْآنَ، وَصَوْتُ الْمُسْتَغْفِرِينَ بِالْأَسْحَارِ": "hadith",
      "إِنَّ اللَّهَ تَبَارَكَ وَتَعَالَىٰ خَلَقَ رِيحًا تَهُبُّ بِالْأَسْحَارِ تَحْمِلُ الْأَذْكَارَ وَالِاسْتِغْفَارَ إِلَىٰ الْمَلِكِ الْجَبَّارِ": "quote",
      "لَقَدْ هَتَفَتْ فِي جُنْحِ لَيْلٍ حَمَامَةٌ * على فننٍ وهناً، وإنّي لنائم": "poem"
    },
    "sufism, servitude, trust, sincerity": {
      "«إِنْ قَدَرْتَ عَلَىٰ بَذْلِ الرُّوحِ فَتَعَالَ، وَ إِلَّا فَلَا تَشْتَغِلْ بِتُرَّهَاتِ الصُّوفِيَّةِ.»": "quote"
    },
    "four to avoid, four to embrace": {
      "كُلُّ الْعَدَاوَةِ قَدْ تُرْجَى إِزَالَتُهَا * إِلَّا عَدَاوَةَ مَنْ عَادَاكَ عَنْ حَسَدٍ": "poem",
      "إِنِّي مَا عَجَزْتُ عَنْ إِحْيَاءِ الْمَوْتَى وَقَدْ عَجَزْتُ عَنْ مُعَالَجَةِ الْأَحْمَقِ": "quote",
      "إِنَّ اللَّهَ لَا يَنْظُرُ إِلَى صُوَرِكُمْ وَلَا إِلَى أَعْمَالِكُمْ وَلَكِنْ يَنْظُرُ إِلَى قُلُوبِكُمْ وَنِيَّاتِكُمْ": "hadith"
    }
  }
}
