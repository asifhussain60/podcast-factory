{
  "schema": "book.quote-kind/v1",
  "chapters": {
    "linguistic meaning of allah": {
      "الشِّرکُ فِی أُمَّتِی أَخفٰی مِن سَیرِ النَّمَلِ فِی لَیلَۃِ الظُّلمَۃِ عَلی سَخْرَۃِ السَّوْدَا": "hadith"
    },
    "linguistic meaning of rehma": {
      "إنَّ الله لَمَّا قَضٰى الخَلق،كَتَبَ فَوقَ عَرْشُه اِنَّ رَحمَتِی تَغلِبُ غَضَبِی": "hadith"
    },
    "the womb of afterlife": {
      "الدُّنْیا رَحْمُ الآخِرَۃ": "hadith"
    },
    "staying steadfast on the path": {
      "أِنَّ فِی الجَسَدِ مُضْغَۃ۔ أِذَا صَلُحَتْ صَلَحَ الجَسَدُ کُلُّہ وَ أِذَا فَسَدَتْ فَسَدَ الجَسَدُ کُلُّہ۔ أَلا وَھِیَ القَلْبٌ": "hadith",
      "كُلُّ بَنِي آدَمَ خَطَّاءٌ, وَخَيْرُ اَلْخَطَّائِينَ اَلتَّوَّابُونَ": "hadith",
      "قَالَ اللهُ تَعَالَى : يَا ابْنَ ادَمَ ، إِنَّكَ مَا دَعَوْتََنِي وَرَجَوْتَنِي ، غَفَرْتُ لَكَ عَلَى مَا كَانَ مِنْكَ وَلَا أُبالِي .": "hadith"
    }
  }
}
