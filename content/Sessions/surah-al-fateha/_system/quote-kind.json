{
  "schema": "book.quote-kind/v1",
  "chapters": {
    "linguistic meaning of allah": {
      "الشِّرکُ فِی أُمَّتِی أَخفٰی مِن سَیرِ النَّمَلِ فِی لَیلَۃِ الظُّلمَۃِ عَلی سَخْرَۃِ السَّوْدَا": {
        "kind": "hadith"
      }
    },
    "linguistic meaning of rehma": {
      "إنَّ الله لَمَّا قَضٰى الخَلق،كَتَبَ فَوقَ عَرْشُه اِنَّ رَحمَتِی تَغلِبُ غَضَبِی": {
        "kind": "quote"
      },
      "المَالِکُ وَ السَّیِّد وَ المُرَبِّی وَ المُرْشَدُ وَ المُنعِمُ وَ القَیِّمُ": {
        "kind": "quote"
      },
      "اِنَّ رَحمَتِی تَغلِبُ غَضَبِی": {
        "kind": "hadith"
      },
      "اِنَّ رَحمَتِی تَغلِبُ غَضَبِی": {
        "kind": "hadith"
      },
      "إنَّ الله لَمَّا قَضٰى الخَلق،كَتَبَ فَوقَ عَرْشُه اِنَّ رَحمَتِی تَغلِبُ غَضَبِی": {
        "kind": "hadith"
      },
      "وَمَنْ أَعْرَضَ عَنِّي نَادَيْتُهُ مِنْ قَرِيبٍ. أَوَلَكَ رَبٌّ غَيْرِي؟": {
        "kind": "hadith"
      }
    },
    "the womb of afterlife": {
      "الدُّنْیا رَحْمُ الآخِرَۃ": {
        "kind": "hadith"
      }
    },
    "staying steadfast on the path": {
      "أِنَّ فِی الجَسَدِ مُضْغَۃ۔ أِذَا صَلُحَتْ صَلَحَ الجَسَدُ کُلُّہ وَ أِذَا فَسَدَتْ فَسَدَ الجَسَدُ کُلُّہ۔ أَلا وَھِیَ القَلْبٌ": {
        "kind": "hadith"
      },
      "كُلُّ بَنِي آدَمَ خَطَّاءٌ, وَخَيْرُ اَلْخَطَّائِينَ اَلتَّوَّابُونَ": {
        "kind": "hadith"
      },
      "قَالَ اللهُ تَعَالَى : يَا ابْنَ ادَمَ ، إِنَّكَ مَا دَعَوْتََنِي وَرَجَوْتَنِي ، غَفَرْتُ لَكَ عَلَى مَا كَانَ مِنْكَ وَلَا أُبالِي .": {
        "kind": "hadith"
      }
    },
    "understanding rab al-alameen": {
      "وَلِکُلِّ عالَمُ لِحَاجَّتاً الی العَالِمٌ": {
        "kind": "poem"
      },
      "بِمَ عَرَفتَ رَبُّك؟": {
        "kind": "quote"
      },
      "إن البِعرَةُ تَدُلُّ علی البَعِیر. والرَّوثَةُ تَدُلُّ علی الحمیر. و آثارُ القدمُ تَدُلُّ علی المَسِیر": {
        "kind": "quote"
      },
      "فسمآءُ ذاتُ اَبرَاج. وَالْاَرْضَ ذَاتَ الْفِجَاجِ. واَبحَرُ ذَاتَ الامواج": {
        "kind": "quote"
      },
      "اَلَا تَدُلُّ عَلَی لَطِیفِ الْخَبِیرِ؟": {
        "kind": "quote"
      },
      "وُجُودُہُ لَہُ دَلِیلُ قَاطِعٌ": {
        "kind": "poem"
      },
      "حَاجَتُ کُلِّ مُحدَثٍ لِصَانعٌ": {
        "kind": "poem"
      }
    }
  }
}
