{
  "name": "podcast-listener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Podcast Factory Library — the audience-facing site. Independent of the admin site in plan-dashboard/.",
  "scripts": {
    "dev": "node scripts/dev-vars.mjs && react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint app scripts workers",
    "lint:fix": "eslint app scripts workers --fix",
    "format": "prettier --write app scripts workers test",
    "format:check": "prettier --check app scripts workers test",
    "ratchets": "node scripts/check-frontend-ratchets.mjs",
    "ratchets:update": "node scripts/check-frontend-ratchets.mjs --update",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run ratchets && npm run test && npm run build",
    "cf-typegen": "wrangler types",
    "fonts": "node scripts/sync-fonts.mjs",
    "brand": "node scripts/derive-brand-assets.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "verify:read-aloud": "node scripts/verify-read-aloud.mjs",
    "security": "node scripts/security-smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply podcast-listener --local",
    "db:seed:local": "node scripts/seed-local-catalog.mjs",
    "dev-vars": "node scripts/dev-vars.mjs",
    "seed:people": "node scripts/seed-people.mjs",
    "controls": "node scripts/controls.mjs",
    "quote-inks": "node scripts/sync-quote-inks.mjs",
    "study-tracks": "node scripts/sync-study-tracks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "better-auth": "^1.6.25",
    "isbot": "^5",
    "kysely": "^0.29.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.60.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
