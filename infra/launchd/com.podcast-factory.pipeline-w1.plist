<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — do NOT load this file directly.

  Generate a machine-specific plist by running:
      bash infra/launchd/install-pipeline-w1.sh install

  That script resolves the repo root at runtime and writes a correctly-pathed
  plist to ~/Library/LaunchAgents/ before loading it via launchctl.

  Why: launchd plists do not support shell variable expansion, so any plist
  stored in the repo must treat absolute paths as stale. The generator script
  uses $(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) to anchor everything to
  the real clone location on this machine.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.podcast-factory.pipeline-w1</string>

    <key>ProgramArguments</key>
    <array>
        <string>GENERATED_AT_INSTALL_TIME</string>
    </array>

    <key>WorkingDirectory</key>
    <string>GENERATED_AT_INSTALL_TIME</string>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>AbandonProcessGroup</key>
    <false/>

    <key>StandardOutPath</key>
    <string>GENERATED_AT_INSTALL_TIME</string>

    <key>StandardErrorPath</key>
    <string>GENERATED_AT_INSTALL_TIME</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/opt/python@3.11/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
