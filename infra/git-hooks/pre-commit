#!/usr/bin/env bash
# Pre-commit hook for podcast-factory.
#
# Enforces DR-009 (no version markers in tracked files):
#   1. Reject any staged file containing a `Version: <digit>` stamp at start of
#      a line (tolerating leading `**` or `#`).
#   2. Reject any staged filename matching `*v[0-9]*.md` or `*v[0-9]*.yaml`,
#      except files under `_archive/`.
#
# Install via `bash infra/git-hooks/install.sh`.

set -e

fail=0

# Collect staged files (added, copied, modified, renamed) — handle no-staged-files cleanly.
staged_files=$(git diff --cached --name-only --diff-filter=ACMR || true)

if [ -z "$staged_files" ]; then
    exit 0
fi

# Check 1 — version stamp inside tracked files.
# Match: optional leading whitespace, optional `**` or `#` prefix, then
# `Version:` followed by whitespace and a digit. Case-sensitive.
version_regex='^[[:space:]]*(\*\*|#)?[[:space:]]*Version:[[:space:]]*[0-9]'

while IFS= read -r f; do
    [ -z "$f" ] && continue
    # Only check files that still exist in the working tree.
    [ -f "$f" ] || continue
    # Skip this hook script itself + the rule sources to avoid self-trip.
    case "$f" in
        infra/git-hooks/*) continue ;;
        _archive/*) continue ;;
    esac
    if grep -nE "$version_regex" "$f" >/dev/null 2>&1; then
        echo "pre-commit: version stamp found in $f (DR-009 violation):" >&2
        grep -nE "$version_regex" "$f" >&2
        fail=1
    fi
done <<< "$staged_files"

# Check 2 — versioned filenames.
# Match: filename basename containing a literal `v` followed by a digit,
# in .md or .yaml extension. Skip _archive/.
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        _archive/*) continue ;;
    esac
    base=$(basename "$f")
    case "$base" in
        *v[0-9]*.md|*v[0-9]*.yaml)
            echo "pre-commit: versioned filename rejected (DR-009): $f" >&2
            fail=1
            ;;
    esac
done <<< "$staged_files"

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: blocked. Strip the version stamp or rename the file." >&2
    echo "pre-commit: bypass requires explicit operator authorization (--no-verify)." >&2
    exit 1
fi

# Check 3 — HTML View Quality gate (WC7c).
# Run the deterministic Cortex linter over staged Astro-site view/layout/style files.
# Blocking-tier checks (inline style= on view pages, external SVG, <svg> w/h attrs,
# <html lang> on layouts) are confirmed green repo-wide; a new MUST violation fails here.
# Non-blocking warnings are advisory. Skips cleanly when node or the script is absent.
view_files=$(printf '%s\n' "$staged_files" \
    | grep -E '^plan-dashboard/src/.*\.(astro|tsx|css)$' || true)

if [ -n "$view_files" ] && command -v node >/dev/null 2>&1 \
        && [ -f plan-dashboard/scripts/lint-html-views.mjs ]; then
    files_csv=$(printf '%s' "$view_files" | paste -sd, -)
    if ! node plan-dashboard/scripts/lint-html-views.mjs --files "$files_csv" >&2; then
        echo "" >&2
        echo "pre-commit: html-view quality gate failed (Cortex MUST violation)." >&2
        echo "pre-commit: fix the findings (see docs/standards/html-view-quality-digest.md)" >&2
        echo "pre-commit: or add a justified reason to plan-dashboard/html-view-lint.config.json." >&2
        echo "pre-commit: bypass requires explicit operator authorization (--no-verify)." >&2
        exit 1
    fi
fi

# Check 4 — corpus durability (never lose hydrated knowledge across machines).
# knowledge.db is gitignored local state; the per-type JSONL exports are the
# committed, diff-friendly, union-mergeable source of truth. On every commit we
# refresh + stage them so the hydrated corpus is always captured in git.
# SAFE mode refuses to shrink the committed corpus (an under-hydrated machine must
# `corpus_sync.py rebuild` first), so this can never clobber a peer's atoms.
# Skips cleanly when the venv/script/DB are absent (non-corpus machines unaffected).
repo_root=$(git rev-parse --show-toplevel)
corpus_db="$repo_root/content/knowledge-base/knowledge.db"
corpus_sync="$repo_root/scripts/podcast/intelligence/corpus_sync.py"
corpus_py="$repo_root/.venv/bin/python"
[ -x "$corpus_py" ] || corpus_py=$(command -v python3 || true)
if [ -f "$corpus_db" ] && [ -f "$corpus_sync" ] && [ -n "$corpus_py" ]; then
    if "$corpus_py" "$corpus_sync" export --safe >/dev/null 2>&1; then
        git add "$repo_root/content/knowledge-base/"*.jsonl 2>/dev/null || true
    else
        echo "pre-commit: corpus export skipped (would shrink committed corpus)." >&2
        echo "pre-commit: run 'python3 scripts/podcast/intelligence/corpus_sync.py rebuild' first." >&2
        # advisory only — never block a commit on corpus sync
    fi
fi

exit 0
