#!/usr/bin/env bash
# Pre-commit hook for podcast-factory.
#
# Enforces DR-009 (no version markers in tracked files):
#   1. Reject any staged file containing a `Version: <digit>` stamp at start of
#      a line (tolerating leading `**` or `#`).
#   2. Reject any staged filename matching `*v[0-9]*.md` or `*v[0-9]*.yaml`,
#      except files under `_archive/`.
#
# Install via `bash infra/git-hooks/install.sh`.

set -e

fail=0

# Collect staged files (added, copied, modified, renamed) — handle no-staged-files cleanly.
staged_files=$(git diff --cached --name-only --diff-filter=ACMR || true)

if [ -z "$staged_files" ]; then
    exit 0
fi

# Check 1 — version stamp inside tracked files.
# Match: optional leading whitespace, optional `**` or `#` prefix, then
# `Version:` followed by whitespace and a digit. Case-sensitive.
version_regex='^[[:space:]]*(\*\*|#)?[[:space:]]*Version:[[:space:]]*[0-9]'

while IFS= read -r f; do
    [ -z "$f" ] && continue
    # Only check files that still exist in the working tree.
    [ -f "$f" ] || continue
    # Skip this hook script itself + the rule sources to avoid self-trip.
    case "$f" in
        infra/git-hooks/*) continue ;;
        _archive/*) continue ;;
    esac
    if grep -nE "$version_regex" "$f" >/dev/null 2>&1; then
        echo "pre-commit: version stamp found in $f (DR-009 violation):" >&2
        grep -nE "$version_regex" "$f" >&2
        fail=1
    fi
done <<< "$staged_files"

# Check 2 — versioned filenames.
# Match: filename basename containing a literal `v` followed by a digit,
# in .md or .yaml extension. Skip _archive/.
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        _archive/*) continue ;;
    esac
    base=$(basename "$f")
    case "$base" in
        *v[0-9]*.md|*v[0-9]*.yaml)
            echo "pre-commit: versioned filename rejected (DR-009): $f" >&2
            fail=1
            ;;
    esac
done <<< "$staged_files"

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: blocked. Strip the version stamp or rename the file." >&2
    echo "pre-commit: bypass requires explicit operator authorization (--no-verify)." >&2
    exit 1
fi

# Check 2b — lint gates (R0, clean-code hardening plan 2026-07-18).
# Ruff (lint + format) over staged Python; DR-005 line-count gate over staged
# scripts/podcast/ production modules; ESLint (errors only) over staged site
# source. Each skips cleanly when its tool is absent.
repo_root=$(git rev-parse --show-toplevel)
ruff_bin="$repo_root/.venv/bin/ruff"
command -v ruff >/dev/null 2>&1 && [ ! -x "$ruff_bin" ] && ruff_bin=$(command -v ruff)

py_staged=$(printf '%s\n' "$staged_files" | grep -E '\.py$' || true)
if [ -n "$py_staged" ] && [ -x "$ruff_bin" ]; then
    if ! printf '%s\n' "$py_staged" | tr '\n' '\0' | xargs -0 "$ruff_bin" check --quiet >&2; then
        echo "pre-commit: ruff check failed. Run: .venv/bin/ruff check --fix" >&2
        exit 1
    fi
    if ! printf '%s\n' "$py_staged" | tr '\n' '\0' | xargs -0 "$ruff_bin" format --check --quiet >&2; then
        echo "pre-commit: ruff format drift. Run: .venv/bin/ruff format" >&2
        exit 1
    fi
fi

dr005_staged=$(printf '%s\n' "$staged_files" | grep -E '^scripts/podcast/.*\.py$' | grep -v '/tests/' || true)
if [ -n "$dr005_staged" ] && [ -f "$repo_root/infra/git-hooks/check-dr005.py" ]; then
    if ! printf '%s\n' "$dr005_staged" | tr '\n' '\0' | xargs -0 python3 "$repo_root/infra/git-hooks/check-dr005.py" >&2; then
        echo "pre-commit: DR-005 line-count gate failed (see above)." >&2
        exit 1
    fi
fi

# AGENTS.md is GENERATED from CLAUDE.md. Staging either without regenerating means the
# two always-loaded instruction files have drifted — which is how AGENTS.md came to be
# missing five standing rules and carrying a blind Claude->Codex rewrite that invented a
# content slug and two filesystem paths.
if printf '%s\n' "$staged_files" | grep -qE '^(CLAUDE|AGENTS)\.md$' \
        && [ -f "$repo_root/scripts/sync_agent_instructions.py" ]; then
    if ! python3 "$repo_root/scripts/sync_agent_instructions.py" --check >&2; then
        echo "pre-commit: AGENTS.md is out of sync with CLAUDE.md." >&2
        exit 1
    fi
fi

# Dead-link gate over the NORMATIVE docs only (agent specs, skills, root docs).
# The 2026-07-26 sweep found 13 dead links, dominated by a handbook tree gone since
# the 2026-05-23 restructure that six files still cited. Historical trees like
# _workspace/reviews/ are deliberately out of scope — their stale paths are correct
# as history, and a gate that flags those gets routed around.
docs_staged=$(printf '%s\n' "$staged_files" \
    | grep -E '^(infra/claude-agents/.*\.md|skills-staging/.*\.md|CLAUDE\.md|AGENTS\.md|framework\.md|README\.md)$' || true)
if [ -n "$docs_staged" ] && [ -f "$repo_root/scripts/check_doc_links.py" ]; then
    files_csv=$(printf '%s\n' "$docs_staged" | paste -sd, -)
    if ! python3 "$repo_root/scripts/check_doc_links.py" --files "$files_csv" >&2; then
        echo "pre-commit: dead link(s) in the normative docs (see above)." >&2
        exit 1
    fi
fi

# repo-surgeon project probe. Runs on EVERY commit rather than on a staged-file
# filter: it validates the tracked contract, root membership, the retired-surface ban,
# agent-mirror and skill-registry parity, the fixture-pinned mirrors, the book-pipeline
# invariants and plan conformance — and almost any commit can break one of those, often
# a commit that touches none of the files involved (deleting a file some contract entry
# names, for instance). At ~0.6s the filter would cost more thought than it saves.
#
# Wired 2026-07-27, once the baseline reached zero. It exits non-zero only on P0/P1;
# P2 and P3 findings are reported without blocking. Until that day the baseline carried
# pre-existing findings, and a gate that fails on somebody else's backlog is a gate
# people learn to bypass.
if [ -f "$repo_root/scripts/repo_surgeon_probe.py" ]; then
    if ! python3 "$repo_root/scripts/repo_surgeon_probe.py" >&2; then
        echo "" >&2
        echo "pre-commit: repo-surgeon probe found P0/P1 finding(s) (see above)." >&2
        echo "pre-commit: catalog + what each id means: skills-staging/repo-surgeon/SKILL.md" >&2
        echo "pre-commit: bypass requires explicit operator authorization (--no-verify)." >&2
        exit 1
    fi
fi

site_staged=$(printf '%s\n' "$staged_files" \
    | grep -E '^plan-dashboard/(src|scripts)/.*\.(ts|tsx|astro|mjs|js)$' || true)
if [ -n "$site_staged" ] && command -v node >/dev/null 2>&1 \
        && [ -d "$repo_root/plan-dashboard/node_modules/eslint" ]; then
    files_rel=$(printf '%s\n' "$site_staged" | sed 's|^plan-dashboard/||' | tr '\n' ' ')
    if ! (cd "$repo_root/plan-dashboard" && npx eslint --quiet --no-warn-ignored $files_rel) >&2; then
        echo "pre-commit: eslint errors on staged site files (warnings don't block)." >&2
        echo "pre-commit: run: cd plan-dashboard && npm run lint:fix" >&2
        exit 1
    fi
fi

# Prettier over staged site files (2026-07-30 audit). The repo has declared a
# `format:check` script since the site existed and NOTHING ever ran it, so drift
# accumulated silently to 21 files — every one of them a file some recent commit had
# touched, which is exactly the population a staged-file gate catches. Styles are in
# scope as well as code: two of the drifted files were CSS, which the eslint gate
# above cannot see at all.
#
# Blocking, unlike eslint's warnings: prettier is not a matter of opinion here, it is
# a single command away, and a formatter that only warns is a formatter nobody runs.
fmt_staged=$(printf '%s\n' "$staged_files" \
    | grep -E '^plan-dashboard/(src|scripts|packages)/.*\.(ts|tsx|astro|mjs|js|css|json)$' || true)
if [ -n "$fmt_staged" ] && command -v node >/dev/null 2>&1 \
        && [ -d "$repo_root/plan-dashboard/node_modules/prettier" ]; then
    files_rel=$(printf '%s\n' "$fmt_staged" | sed 's|^plan-dashboard/||' | tr '\n' ' ')
    if ! (cd "$repo_root/plan-dashboard" \
            && npx prettier --check --ignore-unknown $files_rel) >&2; then
        echo "pre-commit: prettier drift on staged site files." >&2
        echo "pre-commit: run: cd plan-dashboard && npm run format" >&2
        echo "pre-commit: bypass requires explicit operator authorization (--no-verify)." >&2
        exit 1
    fi
fi

# Check 3 — HTML View Quality gate (WC7c).
# Run the deterministic Cortex linter over staged Astro-site view/layout/style files.
# Blocking-tier checks (inline style= on view pages, external SVG, <svg> w/h attrs,
# <html lang> on layouts) are confirmed green repo-wide; a new MUST violation fails here.
# Non-blocking warnings are advisory. Skips cleanly when node or the script is absent.
view_files=$(printf '%s\n' "$staged_files" \
    | grep -E '^plan-dashboard/src/.*\.(astro|tsx|css)$' || true)

if [ -n "$view_files" ] && command -v node >/dev/null 2>&1 \
        && [ -f plan-dashboard/scripts/lint-html-views.mjs ]; then
    files_csv=$(printf '%s' "$view_files" | paste -sd, -)
    if ! node plan-dashboard/scripts/lint-html-views.mjs --files "$files_csv" >&2; then
        echo "" >&2
        echo "pre-commit: html-view quality gate failed (Cortex MUST violation)." >&2
        echo "pre-commit: fix the findings (see docs/standards/html-view-quality-digest.md)" >&2
        echo "pre-commit: or add a justified reason to plan-dashboard/html-view-lint.config.json." >&2
        echo "pre-commit: bypass requires explicit operator authorization (--no-verify)." >&2
        exit 1
    fi
fi

# Check 4 — corpus durability (never lose hydrated knowledge across machines).
# knowledge.db is gitignored local state; the per-type JSONL exports are the
# committed, diff-friendly, union-mergeable source of truth. On every commit we
# refresh + stage them so the hydrated corpus is always captured in git.
# SAFE mode refuses to shrink the committed corpus (an under-hydrated machine must
# `corpus_sync.py rebuild` first), so this can never clobber a peer's atoms.
# Skips cleanly when the venv/script/DB are absent (non-corpus machines unaffected).
repo_root=$(git rev-parse --show-toplevel)
corpus_db="$repo_root/content/knowledge-base/knowledge.db"
corpus_sync="$repo_root/scripts/podcast/intelligence/corpus_sync.py"
corpus_py="$repo_root/.venv/bin/python"
[ -x "$corpus_py" ] || corpus_py=$(command -v python3 || true)
if [ -f "$corpus_db" ] && [ -f "$corpus_sync" ] && [ -n "$corpus_py" ]; then
    if "$corpus_py" "$corpus_sync" export --safe >/dev/null 2>&1; then
        git add "$repo_root/content/knowledge-base/"*.jsonl 2>/dev/null || true
    else
        echo "pre-commit: corpus export skipped (would shrink committed corpus)." >&2
        echo "pre-commit: run 'python3 scripts/podcast/intelligence/corpus_sync.py rebuild' first." >&2
        # advisory only — never block a commit on corpus sync
    fi
fi

exit 0
